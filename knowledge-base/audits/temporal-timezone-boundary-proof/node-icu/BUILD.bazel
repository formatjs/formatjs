load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

genrule(
    name = "node_api_headers",
    srcs = [
        "@nodejs_linux_amd64//:node_bin",
        "@nodejs_linux_amd64//:npm_files",
    ],
    outs = [
        "node-api/js_native_api.h",
        "node-api/js_native_api_types.h",
        "node-api/node_api.h",
        "node-api/node_api_types.h",
    ],
    cmd = """
        node_dir=$$(dirname "$$(dirname "$(execpath @nodejs_linux_amd64//:node_bin)")")
        for output in $(OUTS); do
            cp "$$node_dir/include/node/$$(basename "$$output")" "$$output"
        done
    """,
    tags = ["manual"],
)

cc_library(
    name = "node_api",
    hdrs = [":node_api_headers"],
    strip_include_prefix = "node-api",
    tags = ["manual"],
)

cc_binary(
    name = "libtemporal-node24-icu-addon.so",
    srcs = ["temporal-node24-icu-addon.c"],
    copts = [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-ldl"],
    linkshared = True,
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [":node_api"],
)

# Node's loader recognizes add-ons by the .node filename suffix.
genrule(
    name = "node24_icu_addon",
    srcs = [":libtemporal-node24-icu-addon.so"],
    outs = ["temporal-node24-icu-addon.node"],
    cmd = "cp $< $@",
    tags = ["manual"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)
