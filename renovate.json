{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommitType": "build",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "ignorePaths": [
    "**/node_modules/**",
    "packages/react-intl/example-sandboxes/**"
  ],
  "packageRules": [
    {
      "description": "Keep Ruff parser and AST types on the same revision",
      "groupName": "Ruff",
      "matchPackageNames": ["ruff_python_ast", "ruff_python_parser", "ruff_text_size"]
    },
    {
      "description": "Group NAPI-RS updates",
      "groupName": "NAPI-RS",
      "matchPackageNames": ["napi", "napi-derive"]
    },
    {
      "description": "Keep Ruff parser, AST, and text ranges on the same revision",
      "groupName": "Ruff",
      "matchPackageNames": [
        "ruff_python_ast",
        "ruff_python_parser",
        "ruff_text_size"
      ]
    },
    {
      "description": "Group OXC updates",
      "groupName": "OXC",
      "matchPackageNames": [
        "oxc",
        "oxc_allocator",
        "oxc_ast",
        "oxc_data_structures",
        "oxc_parser",
        "oxc_span",
        "oxc-parser",
        "oxc-transform"
      ]
    },
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
