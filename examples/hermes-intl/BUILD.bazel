load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":dist.bzl", "smoke_macos_arm64")

genrule(
    name = "pluralrules_smoke_source",
    srcs = ["@formatjs_intl_getcanonicallocales_hermes//:js/pluralrules-smoke.js"],
    outs = ["pluralrules_smoke.inc"],
    cmd = "printf 'R\"FORMATJS(' > $@; cat $< >> $@; printf ')FORMATJS\"' >> $@",
)

SMOKE_SOURCES = [
    "main.cpp",
    ":pluralrules_smoke_source",
]

genrule(
    name = "extension_bytecode",
    srcs = ["@formatjs_intl_getcanonicallocales_hermes//:js/extensions.js"],
    outs = ["extensions.hbc"],
    cmd = "$(execpath @hermes//:hermesc) -O -emit-binary -out $@ $(execpath @formatjs_intl_getcanonicallocales_hermes//:js/extensions.js)",
    tools = ["@hermes//:hermesc"],
)

cc_binary(
    name = "smoke",
    srcs = SMOKE_SOURCES,
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    linkstatic = True,
    tags = ["manual"],
    deps = [
        "@formatjs_intl_getcanonicallocales_hermes//:canonical_locales",
        "@formatjs_intl_getcanonicallocales_hermes//:locale",
        "@formatjs_intl_getcanonicallocales_hermes//:pluralrules",
        "@formatjs_intl_getcanonicallocales_hermes//:supported_values",
        "@hermes//:hermes_vm",
    ],
)

cc_test(
    name = "smoke_test",
    size = "small",
    srcs = SMOKE_SOURCES,
    args = ["$(rootpath :extension_bytecode)"],
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    data = [":extension_bytecode"],
    linkstatic = True,
    deps = [
        "@formatjs_intl_getcanonicallocales_hermes//:canonical_locales",
        "@formatjs_intl_getcanonicallocales_hermes//:locale",
        "@formatjs_intl_getcanonicallocales_hermes//:pluralrules",
        "@formatjs_intl_getcanonicallocales_hermes//:supported_values",
        "@hermes//:hermes_vm",
    ],
)

smoke_macos_arm64(
    name = "smoke_macos_arm64",
    srcs = [":smoke"],
    tags = ["manual"],
)
