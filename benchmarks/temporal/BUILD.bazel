load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//tools:compile.bzl", "formatjs_library")
load("//tools:package_json.bzl", "generate_package_json")
load("//tools:rolldown.bzl", "rolldown_bundle")
load("//tools:tsconfig.bzl", "ESNEXT_TSCONFIG", "packages_tsconfig")

# gazelle:ignore

generate_package_json(
    package_name = "temporal-benchmark",
    private = True,
    type = "module",
    version = "0.0.0",
)

formatjs_library(
    name = "temporal",
    srcs = [
        "benchmark.ts",
        "calendar-entry.ts",
        "facade-benchmark.ts",
        "instant-entry.ts",
        "kernel-entry.ts",
        "reference.ts",
        "zones-entry.ts",
    ],
    tsconfig = packages_tsconfig(ESNEXT_TSCONFIG),
    tsconfig_types = ["node"],
    deps = [
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@types/node",
        "//:node_modules/esbuild",
        "//:node_modules/temporal-polyfill",
        "//packages/temporal:types",
    ],
)

[
    rolldown_bundle(
        name = name,
        srcs = [
            entry,
            ":srcs",
            "//packages/temporal:runtime_sources",
        ],
        entry_point = entry,
        platform = "node",
        target = "es2022",
        deps = [
            "//:node_modules/temporal-polyfill",
            "//packages/temporal:lib",
        ],
    )
    for name, entry in [
        ("kernel-code", "kernel-entry.ts"),
        ("calendar-code", "calendar-entry.ts"),
        ("instant-code", "instant-entry.ts"),
        ("kernel-all-zones", "zones-entry.ts"),
        ("reference-bundle", "reference.ts"),
    ]
]

[
    js_binary(
        name = name,
        data = [":generated_package_json"] + bundles + [
            "//:node_modules/@bazel/runfiles",
            "//:node_modules/esbuild",
        ],
        entry_point = entry,
    )
    for name, entry, bundles in [
        (
            "benchmark",
            "benchmark.ts",
            [
                ":kernel-all-zones",
                ":kernel-code",
                ":reference-bundle",
            ],
        ),
        (
            "facade_benchmark",
            "facade-benchmark.ts",
            [
                ":instant-code",
                ":calendar-code",
                ":reference-bundle",
            ],
        ),
    ]
]
