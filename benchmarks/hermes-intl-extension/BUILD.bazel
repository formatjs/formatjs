# gazelle:ignore

load("//tools:rolldown.bzl", "rolldown_bundle")

rolldown_bundle(
    name = "suite_bundle",
    srcs = [
        "setup.ts",
        "suite.ts",
    ],
    entry_point = "suite.ts",
    format = "iife",
    target = "es2020",
    deps = [
        "//:node_modules/@formatjs/intl-collator",
        "//:node_modules/@formatjs/intl-datetimeformat",
        "//:node_modules/@formatjs/intl-displaynames",
        "//:node_modules/@formatjs/intl-durationformat",
        "//:node_modules/@formatjs/intl-getcanonicallocales",
        "//:node_modules/@formatjs/intl-listformat",
        "//:node_modules/@formatjs/intl-locale",
        "//:node_modules/@formatjs/intl-numberformat",
        "//:node_modules/@formatjs/intl-pluralrules",
        "//:node_modules/@formatjs/intl-relativetimeformat",
        "//:node_modules/@formatjs/intl-segmenter",
        "//:node_modules/@formatjs/intl-supportedvaluesof",
        "//:node_modules/@formatjs_generated/tz",
        "//packages/intl-datetimeformat:locale-data/en.js",
        "//packages/intl-displaynames:locale-data/en.js",
        "//packages/intl-listformat:locale-data/en.js",
        "//packages/intl-numberformat:locale-data/en.js",
        "//packages/intl-pluralrules:locale-data/en.js",
        "//packages/intl-relativetimeformat:locale-data/en.js",
    ],
)

genrule(
    name = "overlap_bytecode",
    srcs = ["overlap.js"],
    outs = ["overlap.hbc"],
    cmd = "$(execpath @hermes//:hermesc) -O -emit-binary -out $@ $(execpath overlap.js)",
    tools = ["@hermes//:hermesc"],
)

genrule(
    name = "magrinj_bootstrap_bytecode",
    srcs = [
        "magrinj.LICENSE",
        "@magrinj_hermes_intl_bootstrap//file",
    ],
    outs = [
        "magrinj-bootstrap.LICENSE",
        "magrinj-bootstrap.hbc",
    ],
    cmd = """
(
  echo '(function (module) {'
  cat $(execpath @magrinj_hermes_intl_bootstrap//file)
  echo 'return module.exports;'
  echo '})({})'
) > $(@D)/magrinj-bootstrap-wrapper.js
$(execpath @hermes//:hermesc) -O -emit-binary -out $(@D)/magrinj-bootstrap.hbc $(@D)/magrinj-bootstrap-wrapper.js
cp $(execpath magrinj.LICENSE) $(@D)/magrinj-bootstrap.LICENSE
""",
    tools = ["@hermes//:hermesc"],
)
