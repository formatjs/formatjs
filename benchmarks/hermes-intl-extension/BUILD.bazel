# gazelle:ignore

load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("//tools:rolldown.bzl", "rolldown_bundle")

rolldown_bundle(
    name = "suite_bundle",
    srcs = [
        "setup.ts",
        "suite.ts",
    ],
    entry_point = "suite.ts",
    format = "iife",
    target = "es2020",
    deps = [
        "//:node_modules/@formatjs/intl-collator",
        "//:node_modules/@formatjs/intl-datetimeformat",
        "//:node_modules/@formatjs/intl-displaynames",
        "//:node_modules/@formatjs/intl-durationformat",
        "//:node_modules/@formatjs/intl-getcanonicallocales",
        "//:node_modules/@formatjs/intl-listformat",
        "//:node_modules/@formatjs/intl-locale",
        "//:node_modules/@formatjs/intl-numberformat",
        "//:node_modules/@formatjs/intl-pluralrules",
        "//:node_modules/@formatjs/intl-relativetimeformat",
        "//:node_modules/@formatjs/intl-segmenter",
        "//:node_modules/@formatjs/intl-supportedvaluesof",
        "//:node_modules/@formatjs_generated/tz",
        "//packages/intl-datetimeformat:locale-data/en.js",
        "//packages/intl-displaynames:locale-data/en.js",
        "//packages/intl-listformat:locale-data/en.js",
        "//packages/intl-numberformat:locale-data/en.js",
        "//packages/intl-pluralrules:locale-data/en.js",
        "//packages/intl-relativetimeformat:locale-data/en.js",
    ],
)

genrule(
    name = "overlap_bytecode",
    srcs = ["overlap.js"],
    outs = ["overlap.hbc"],
    cmd = "$(execpath @hermes//:hermesc) -O -emit-binary -out $@ $(execpath overlap.js)",
    tools = ["@hermes//:hermesc"],
)

genrule(
    name = "canonical_tag_control_bytecode",
    srcs = ["canonical-tag-control.js"],
    outs = ["canonical-tag-control.hbc"],
    cmd = "$(execpath @hermes//:hermesc) -O -emit-binary -out $@ $(execpath canonical-tag-control.js)",
    tools = ["@hermes//:hermesc"],
)

genrule(
    name = "locale_control_bytecode",
    srcs = ["locale-control.js"],
    outs = ["locale-control.hbc"],
    cmd = "$(execpath @hermes//:hermesc) -O -emit-binary -out $@ $(execpath locale-control.js)",
    tools = ["@hermes//:hermesc"],
)

genrule(
    name = "magrinj_bootstrap_bytecode",
    srcs = [
        "magrinj.LICENSE",
        "@magrinj_hermes_intl_bootstrap//file",
    ],
    outs = [
        "magrinj-bootstrap.LICENSE",
        "magrinj-bootstrap.hbc",
    ],
    cmd = """
(
  echo '(function (module) {'
  cat $(execpath @magrinj_hermes_intl_bootstrap//file)
  echo 'return module.exports;'
  echo '})({})'
) > $(@D)/magrinj-bootstrap-wrapper.js
$(execpath @hermes//:hermesc) -O -emit-binary -out $(@D)/magrinj-bootstrap.hbc $(@D)/magrinj-bootstrap-wrapper.js
cp $(execpath magrinj.LICENSE) $(@D)/magrinj-bootstrap.LICENSE
""",
    tools = ["@hermes//:hermesc"],
)

rust_binary(
    name = "matcher_probe",
    srcs = ["matcher-probe.rs"],
    crate_name = "hermes_matcher_probe",
    edition = "2024",
    deps = [
        "//crates/intl_listformat:with_compiled_data",
        "//crates/intl_locale",
        "//crates/intl_localematcher",
    ],
)

rust_binary(
    name = "relative_constructor_probe",
    srcs = ["relative-constructor-probe.rs"],
    crate_name = "hermes_relative_constructor_probe",
    edition = "2024",
    deps = ["//crates/intl_relativetimeformat:with_compiled_data"],
)

[
    rust_binary(
        name = name,
        srcs = ["relative-format-probe.rs"],
        crate_features = features,
        crate_name = "hermes_relative_format_probe",
        edition = "2024",
        deps = [
            "//crates/intl_numberformat:with_compiled_data",
            "//crates/intl_relativetimeformat:with_compiled_data",
        ],
    )
    for name, features in [
        ("relative_format_probe", []),
        (
            "relative_allocation_probe",
            ["count_allocations"],
        ),
    ]
]

[
    rust_binary(
        name = name,
        srcs = ["mathematical-probe.rs"],
        crate_features = features,
        crate_name = "hermes_mathematical_probe",
        edition = "2024",
        deps = ["//crates/intl_pluralrules:with_compiled_data"],
    )
    for name, features in [
        ("mathematical_probe", []),
        (
            "mathematical_allocation_probe",
            ["count_allocations"],
        ),
    ]
]

genrule(
    name = "list_size_control_bytecode",
    srcs = ["list-size-control.js"],
    outs = ["list-size-control.hbc"],
    cmd = "$(execpath @hermes//:hermesc) -O -emit-binary -out $@ $(execpath list-size-control.js)",
    tools = ["@hermes//:hermesc"],
)

[
    rust_binary(
        name = name,
        srcs = ["list-traversal-probe.rs"],
        crate_features = features,
        crate_name = "hermes_list_traversal_probe",
        edition = "2024",
        deps = ["//crates/intl_listformat:with_compiled_data"],
    )
    for name, features in [
        ("list_traversal_probe", []),
        (
            "list_allocation_probe",
            ["count_allocations"],
        ),
    ]
]
