# Explicit install smoke: packages are large and exercise a real Yarn cache.
js_test(
    name = "yarn_install_test",
    size = "large",
    args = ["$(rootpath @yarn_install_test_cli//file)"],
    data = [
        "yarn-install.test.mjs",
        "//packages/bigdecimal:pkg",
        "//packages/fast-memoize:pkg",
        "//packages/intl-datetimeformat:pkg",
        "//packages/intl-datetimeformat-calendar-chinese:pkg",
        "//packages/intl-datetimeformat-calendar-hebrew:pkg",
        "//packages/intl-datetimeformat-calendar-japanese:pkg",
        "//packages/intl-localematcher:pkg",
        "@yarn_install_test_cli//file",
    ],
    entry_point = "yarn-install.test.mjs",
    no_copy_to_bin = ["@yarn_install_test_cli//file"],
    tags = ["manual"],
)
