        "//:node_modules/@formatjs_generated/tz",
        "//:node_modules/vitest",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
        "//packages/intl-datetimeformat/calendars",
    ],
)

generate_tz_data(
    name = "tz_data_generated",
)

filegroup(
    name = "zdumps",
    srcs = ["tz_data_generated/zdump/%s" % zone for zone in ZONES],
)

# CLDR

cldr_locale_list(
    name = "locales",
    cldr_package = "cldr-dates-full",
    data = [
        "//:node_modules/cldr-dates-full",
    ],
    file_glob = "*/ca-gregorian.json",
)

CLDR_RAW_FILES = ["cldr-raw/%s.json" % locale for locale in ALL_LOCALES]

ts_run_binary(
    name = "cldr-raw",
    srcs = [
        "types.ts",
        "//:node_modules/@formatjs/intl-locale",
        "//:node_modules/cldr-bcp47",
        "//:node_modules/cldr-cal-buddhist-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-chinese-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-coptic-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-dangi-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-ethiopic-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-hebrew-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-indian-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-islamic-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-japanese-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-persian-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-cal-roc-full",  # keep: dynamic calendar JSON imports
        "//:node_modules/cldr-core",
        "//:node_modules/cldr-dates-full",
        "//:node_modules/cldr-numbers-full",
        "//:node_modules/fast-glob",
        "//:node_modules/fs-extra",
        "//:node_modules/json-stable-stringify",
        "//:node_modules/lodash-es",
        "//:node_modules/minimist",
        "//:root_package_json",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
    ],
    outs = CLDR_RAW_FILES,
    args = [
        "--outDir",
        "cldr-raw",
    ],
    chdir = package_name(),
    tool = "//packages/intl-datetimeformat/scripts:cldr-raw",
)

ts_run_binary(
    name = "locale-data-json",
    srcs = CLDR_RAW_FILES + [
        "//:node_modules/fs-extra",
        "//:node_modules/minimist",
    ],
    outs = ["locale-data-json/%s.json" % locale for locale in ALL_LOCALES],
    args = [
        "--cldrFile %s" % f
        for f in CLDR_RAW_FILES
    ] + [
        "--outDir",
        "locale-data-json",
    ],
    chdir = package_name(),
    tool = "//packages/intl-datetimeformat/scripts:cldr",
    visibility = ["//visibility:public"],
)

ts_run_binary(
    name = "locale-data",
    srcs = [":locale-data-json"],
    outs = ["locale-data/%s.%s" % (locale, extension) for locale in ALL_LOCALES for extension in [
        "js",
        "d.ts",
    ]],
    args = ["--input locale-data-json/%s.json" % locale for locale in ALL_LOCALES] + [
        "--outDir",
        "locale-data",
        "--method",
        "__addLocaleData",
        "--queue",
        "__FORMATJS_DATETIMEFORMAT_DATA__",
    ],
    chdir = package_name(),
    tool = "//packages/intl-datetimeformat/scripts:emit-locale-data",
    visibility = ["//visibility:public"],
)

[genrule(
    name = "tests-locale-data-%s" % locale,
    srcs = ["cldr-raw/%s.json" % locale],
    outs = ["tests/locale-data/%s.json" % locale],
    cmd = "cp $< $@",
) for locale in TEST_LOCALES]

[
    ts_run_binary(
        name = "test262%s-main-gen" % suffix,
        srcs = [
            ":cldr-raw",
            "//:node_modules/fs-extra",
            "//:node_modules/minimist",
        ],
        outs = ["test262%s-main.ts" % suffix],
        args = [
            "--cldrFile %s/cldr-raw/%s.json" % (
                package_name(),
                f,
            )
            for f in locales
            if f in ALL_LOCALES
        ] + [
            "--out",
            "$(rootpath test262%s-main.ts)" % suffix,
        ],
        tool = "//packages/intl-datetimeformat/scripts:test262-main-gen",
    )
    for suffix, locales in [
        ("", TEST262_LOCALES),
        (
            "-en",
            ["en"],
        ),
    ]
]

# @formatjs_generated/tz — IANA timezone data
generate_package_file(
    name = "tz_links",
    src = "links.ts",
    args = [
        "--input",
        package_name() + "/tz_data_generated/backward",
    ],
    data = [
        ":tz_data_generated/backward",
        "//:node_modules/json-stable-stringify",
    ],
    tags = ["cldr"],
    tool = "//packages/intl-datetimeformat/scripts:link",
)

generate_package_file(
    name = "tz_all_tz",
    src = "all-tz.ts",
    args = [
        "$(rootpaths :zdumps)",
    ],
    data = [
        "types.ts",
        ":zdumps",
        "//:node_modules/json-stable-stringify",
        "//:root_package_json",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
    ],
    tags = ["cldr"],
    tool = "//packages/intl-datetimeformat/scripts:process-zdump",
)

formatjs_generated_package(
    name = "tz_pkg",
    package_name = "tz",
    srcs = [
        ":tz_all_tz",
        ":tz_links",
    ],
)

# Raw packs use the same pinned IANA and golden-zone selection as JS.
[
    ts_run_binary(
        name = "tz_%s_json" % selection,
        srcs = [
            "types.ts",
            ":zdumps",
            "//:node_modules/fs-extra",
            "//:node_modules/json-stable-stringify",
            "//:node_modules/minimist",
            "//:root_package_json",
        ],
        outs = ["tz-%s.json" % selection],
        args = ["--json"] + (["--golden"] if selection == "golden" else []) + [
            "$(rootpaths :zdumps)",
            "--out",
            "$(rootpath tz-%s.json)" % selection,
        ],
        tool = "//packages/intl-datetimeformat/scripts:process-zdump",
        visibility = [
            "//crates:__pkg__",
            "//crates/intl_datetimeformat:__subpackages__",
            "//packages/intl-datetimeformat/benchmark:__pkg__",
        ],
    )
    for selection in [
        "all",
        "golden",
    ]
]

# "ts-node scripts/process-zdump --polyfill --output dist/add-all-tz.js --input data.zdump"
# add-all-tz
ts_run_binary(
    name = "add-all-tz",
    srcs = [
        "types.ts",
        ":zdumps",
        "//:node_modules/fs-extra",
        "//:node_modules/json-stable-stringify",
        "//:node_modules/minimist",
        "//:root_package_json",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
    ],
    outs = ["add-all-tz.js"],
    args = [
        "--polyfill",
        "$(rootpaths :zdumps)",
        "--out",
        "$(rootpath add-all-tz.js)",
    ],
    tool = "//packages/intl-datetimeformat/scripts:process-zdump",
    visibility = [
        "//packages/intl:__subpackages__",
        "//packages/react-intl:__subpackages__",
    ],
)

# add-golden-tz
ts_run_binary(
    name = "add-golden-tz",
    srcs = [
        "types.ts",
        ":zdumps",
        "//:node_modules/fs-extra",
        "//:node_modules/json-stable-stringify",
        "//:node_modules/minimist",
        "//:root_package_json",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
    ],
    outs = ["add-golden-tz.js"],
    args = [
        "--golden",
        "--polyfill",
        "$(rootpaths :zdumps)",
        "--out",
        "$(rootpath add-golden-tz.js)",
    ],
    tool = "//packages/intl-datetimeformat/scripts:process-zdump",
)

genrule(
    name = "add-all-tz-typedef",
    outs = ["add-all-tz.d.ts"],
    cmd = "echo 'export {}' > $@",
)

genrule(
    name = "add-golden-tz-typedef",
    outs = ["add-golden-tz.d.ts"],
    cmd = "echo 'export {}' > $@",
)

rolldown_bundle(
    name = "polyfill.iife",
    srcs = [":srcs"],
    entry_point = "polyfill.ts",
    target = "es2020",
    deps = [
        "//:node_modules/@formatjs/bigdecimal",
        "//:node_modules/@formatjs/intl-localematcher",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
    ],
)

filegroup(
    name = "benchmark_locale_data",
    srcs = [":tests-locale-data-en"],
    visibility = ["//packages/intl-datetimeformat/benchmark:__pkg__"],
)

filegroup(
    name = "serialization_test_data",
    srcs = [
        ":cldr-raw/en.json",
        ":locale-data/en.js",
        "//packages/intl-datetimeformat-calendar-hebrew:locale-data/en.js",
    ],
    visibility = ["//packages/intl-datetimeformat/scripts:__pkg__"],
)

# Use with `bazel run`.
alias(
    name = "benchmark",
    actual = "//packages/intl-datetimeformat/benchmark:run",
    tags = ["manual"],
)

[
    rolldown_bundle(
        name = "test262%s-polyfill" % suffix,
        srcs = [
            ":srcs",
            ":test262%s-main-gen" % suffix,
        ],
        entry_point = "test262%s-main.ts" % suffix,
        format = "iife",
        target = "es2020",
        visibility = ["//tools/test262:__pkg__"],
        deps = [
            "//:node_modules/@formatjs/bigdecimal",
            "//:node_modules/@formatjs/intl-localematcher",
            "//:node_modules/@formatjs_generated/tz",
            "//packages/ecma262-abstract",
            "//packages/ecma402-abstract",
            "//packages/ecma402-abstract/DateTimeFormat",
            "//packages/ecma402-abstract/types",
            "//packages/intl-datetimeformat/calendars",  # keep: generated prelude loads optional calendars
        ],
    )
    for suffix in [
        "",
        "-en",
    ]
]

test262_test(
    name = "test262",
    timeout = "eternal",
    data = [
        "@com_github_tc39_test262//:test262-datetimeformat-copy",
        "@com_github_tc39_test262//:test262-harness-copy",
    ],
    estimated_memory = "6GB",
    prelude = "test262-polyfill.js",
    suite = "intl402/DateTimeFormat",
    threads = 4,
)

formatjs_test(
    name = "temporal_test",
    srcs = [
        "tests/temporal.test.ts",
        ":tests-locale-data-en",
    ],
    node_toolchain = "//tools/test262:node-runtime",
    deps = TEST_DEPS,
)

formatjs_test(
    name = "temporal_polyfill_test",
    srcs = [
        "tests/temporal-polyfill.test.ts",
        ":tests-locale-data-en",
        ":tests-locale-data-ko",  # keep: generated locale data imported by tests
        ":tests-locale-data-zh-Hans",  # keep: generated locale data imported by tests
    ],
    deps = TEST_DEPS + ["//:node_modules/temporal-polyfill"],
)

filegroup(
    name = "calendar_cldr_raw",
    srcs = CLDR_RAW_FILES,
    visibility = ["//visibility:public"],
)

validate_calendar_sources(
    kind = "calendar entrypoint",
    sources = glob(["calendar-data/*.ts"]),
)

formatjs_test(
    name = "calendar_test",
    srcs = ["tests/CalendarDateFromTime.test.ts"],
    node_toolchain = "//tools/test262:node-runtime",
    deps = [
        "//:node_modules/vitest",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/intl-datetimeformat/calendars",
    ],
)

formatjs_test(
    name = "rust_timezone_test",
    size = "large",
    srcs = [
        "tests/rust-timezones.test.ts",
        "types.ts",
        "unpack.ts",
    ],
    data = [
        ":add-all-tz",
        ":add-golden-tz",
        ":tz_all_json",
        ":tz_golden_json",
        "//crates/intl_datetimeformat:timezone_conformance",
    ],
    deps = [
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@formatjs_generated/tz",
