formatjs_test(
    name = "timezone_data_test",
    srcs = [
        "types.ts",
        "//packages/intl-datetimeformat/scripts:timezone_test_sources",
    ],
    deps = [
        "//:node_modules/@types/fs-extra",
        "//:node_modules/@types/minimist",
        "//:node_modules/@types/node",
        "//:node_modules/fs-extra",
        "//:node_modules/json-stable-stringify",
        "//:node_modules/minimist",
        "//:node_modules/vitest",
        "//packages/ecma402-abstract/types",
    ],
)

filegroup(
    name = "rust_pattern_cldr_data",
    testonly = True,
    srcs = ["cldr-raw/%s.json" % locale for locale in [
        "en",
        "fr",
        "ar",
        "ja",
        "zh-Hans",
        "ru",
        "hi",
        "he",
    ]],
