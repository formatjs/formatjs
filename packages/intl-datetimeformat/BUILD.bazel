exports_files(["LICENSE.md"])

PACKAGE_NAME = "intl-datetimeformat"

TEST_LOCALES = [
    "ar",
    "ar-EG",
    "bn",
    "bs",
    "de",
    "en",
    "en-GB",
    "en-CA",
    "ja",
    "ko",
    "my",
    "ne",
    "pl",
    "ru",
    "zh-Hans",
    "fa",
    "fi",
    "nl",
]

TEST_DEPS = [
    "//packages/ecma262-abstract",
    "//packages/ecma402-abstract",
    "//packages/ecma402-abstract/DateTimeFormat",
    "//packages/intl-datetimeformat/calendars",
    "//packages/ecma402-abstract/types",
    "//:node_modules/@formatjs/intl-localematcher",
    "//:node_modules/@formatjs/bigdecimal",
    "//:node_modules/@formatjs/intl-getcanonicallocales",
    "//:node_modules/@formatjs/intl-locale",
    "//:node_modules/@types/node",
]

ENTRY_POINTS = [
    "index.ts",
    "polyfill.ts",
    "polyfill-force.ts",
    "should-polyfill.ts",
]

formatjs_library(
    name = "intl-datetimeformat",
    package_name = "@formatjs/intl-datetimeformat",
    srcs = [
        "add-all-calendars.ts",
        "calendar-data/buddhist.ts",
        "calendar-data/chinese.ts",
        "calendar-data/coptic.ts",
        "calendar-data/dangi.ts",
        "calendar-data/ethioaa.ts",
        "calendar-data/ethiopic.ts",
        "calendar-data/hebrew.ts",
        "calendar-data/indian.ts",
        "calendar-data/islamic-civil.ts",
        "calendar-data/islamic-tbla.ts",
        "calendar-data/islamic-umalqura.ts",
        "calendar-data/japanese.ts",
        "calendar-data/persian.ts",
        "calendar-data/roc.ts",
        "core.ts",
        "get_internal_slots.ts",
        "index.ts",
        "polyfill.ts",
        "polyfill-force.ts",
        "register-calendar-data.ts",
        "should-polyfill.ts",
        "to_locale_string.ts",
        "types.ts",  # keep
        "unpack.ts",  # keep
    ],
    author = "Long Ho <holevietlong@gmail.com>",
    bugs = "https://github.com/formatjs/formatjs/issues",
    description = "Intl.DateTimeFormat polyfill",
    entry_points = ENTRY_POINTS,
    extra_npm_srcs = [
        "add-all-tz.d.ts",
        "add-all-tz.js",
        "add-golden-tz.d.ts",
        "add-golden-tz.js",
        ":locale-data",
        "polyfill.iife.js",
    ],
    homepage = "https://github.com/formatjs/formatjs#readme",
    keywords = [
        "datetimeformat",
        "formatjs",
        "i18n",
        "intl",
        "polyfill",
    ],
    license = "MIT",
    package_types = "index.d.ts",
    repository = "formatjs/formatjs.git",
    type = "module",
    types = True,
    version = "8.0.0",  # x-release-please-version
    visibility = ["//visibility:public"],
    exports = {
        ".": "./index.js",
        "./polyfill.js": "./polyfill.js",
        "./polyfill-force.js": "./polyfill-force.js",
        "./should-polyfill.js": "./should-polyfill.js",
        "./add-all-tz.js": "./add-all-tz.js",
        "./add-golden-tz.js": "./add-golden-tz.js",
        "./locale-data/*": "./locale-data/*",
        "./locale-data": "./locale-data",
    },
    deps = [
        "//:node_modules/@formatjs/bigdecimal",
        "//:node_modules/@formatjs/intl-localematcher",
        "//:node_modules/@formatjs_generated/cldr.supported-locales",
        "//:node_modules/@formatjs_generated/tz",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/types",
        "//packages/intl-datetimeformat/calendars",
    ],
)

formatjs_test(
    name = "intl-datetimeformat_test",
    srcs = [
        "tests/abstract/BestFitFormatMatcher.test.ts",
        "tests/abstract/skeleton.test.ts",
        "tests/calendar-loading.test.ts",
