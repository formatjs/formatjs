copy_to_bin(
    name = "hermes_package_tests",
    srcs = glob(["tests/**/*.ts"]) + ["tests/locale-data/%s.json" % locale for locale in TEST_LOCALES] + [":srcs"],
    visibility = ["//native/hermes/tests:__pkg__"],
