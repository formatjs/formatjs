load("//tools:compile.bzl", "formatjs_library")
load("//tools:source_inventory.bzl", "source_inventory")

formatjs_library(
    name = "calendars",
    srcs = [
        "all.ts",
        "implementations/buddhist.ts",
        "implementations/chinese.ts",
        "implementations/coptic.ts",
        "implementations/dangi.ts",
        "implementations/ethioaa.ts",
        "implementations/ethiopic.ts",
        "implementations/hebrew.ts",
        "implementations/indian.ts",
        "implementations/islamic-civil.ts",
        "implementations/islamic-tbla.ts",
        "implementations/islamic-umalqura.ts",
        "implementations/japanese.ts",
        "implementations/persian.ts",
        "implementations/roc.ts",
        "temporal.ts",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@formatjs_generated/icu.calendar",
        "//:node_modules/temporal-polyfill",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract/DateTimeFormat",
    ],
)

source_inventory(
    name = "calendar_implementation_inventory",
    out = "calendar_implementation_inventory.json",
    names = [path.split("/")[-1][:-3] for path in glob(["implementations/*.ts"])],
    visibility = ["//tools:__pkg__"],
)
