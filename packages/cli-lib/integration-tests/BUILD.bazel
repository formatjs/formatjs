load("//tools:package_json.bzl", "generate_package_json")
load("//tools:test.bzl", "formatjs_test")

generate_package_json(
    package_name = "integration-tests",
    private = True,
    type = "module",
)

# Hand-rolled js_test that runs a one-off ESM smoke test.
# gazelle:ts_enabled false

formatjs_test(
    name = "esm_compatibility_test",
    size = "small",
    timeout = "short",
    data = [
        "//:node_modules/@formatjs/cli-lib",
    ],
    entry_point = "test_esm_imports.mjs",
)

formatjs_test(
    name = "wasi_package_test",
    size = "small",
    data = [
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@emnapi/core",
        "//:node_modules/@emnapi/runtime",
        "//:node_modules/@formatjs/icu-messageformat-parser",
        "//packages/cli:pkg",
        "//packages/cli-lib:pkg",
    ],
    entry_point = "test_wasi_packages.mjs",
    env = {"FORMATJS_FORCE_WASI": "1"},
)
