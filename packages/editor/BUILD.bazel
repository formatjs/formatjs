load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

# gazelle:ts_enabled false
load("//tools:compile.bzl", "formatjs_library")
load("//tools:package_json.bzl", "generate_package_json")
load("//tools:test.bzl", "formatjs_test")

package(default_visibility = ["//packages/editor:__subpackages__"])

generate_package_json(
    package_name = "@formatjs/editor",
    author = "Long Ho <holevietlong@gmail.com>",
    bugs = {
        "url": "https://github.com/formatjs/formatjs/issues",
    },
    description = "Headless ICU MessageFormat editor for React",
    homepage = "https://github.com/formatjs/formatjs",
    keywords = [
        "intl",
        "i18n",
        "internationalization",
        "locale",
        "localization",
        "globalization",
        "react",
        "react-intl",
        "reactjs",
        "format",
        "formatjs",
        "formatting",
        "translate",
        "translation",
        "cli",
    ],
    license = "MIT",
    repository = {
        "type": "git",
        "url": "git+ssh://git@github.com/formatjs/formatjs.git",
    },
    type = "module",
    types = "index.d.ts",
    version = "3.0.28",
    exports = {
        ".": "./index.js",
    },
    deps = [
        "//:node_modules/@formatjs/icu-messageformat-parser",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

formatjs_library(
    name = "editor",
    srcs = [
        "index.tsx",
        "message.tsx",
        "types.ts",
    ],
    entry_points = ["index.tsx"],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@formatjs/icu-messageformat-parser",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

copy_to_bin(
    name = "vrt_sources",
    srcs = ["demo.tsx"],
    visibility = ["//visibility:public"],
)

formatjs_test(
    name = "unit_test",
    srcs = ["editor.test.tsx"],
    data = [
        ":unit_test_types",
        "//:package.json",
    ],
    dom = True,
    deps = [
        ":lib",
        "//:node_modules/@testing-library/react",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/vitest",
    ],
)

filegroup(
    name = "unit_test_types",
    testonly = True,
    srcs = [":unit_test_typecheck"],
    output_group = "transitive_typecheck",
)
