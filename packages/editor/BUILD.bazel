load("//tools:compile.bzl", "formatjs_library")
load("//tools:test.bzl", "formatjs_test")

formatjs_library(
    name = "editor",
    package_name = "@formatjs/editor",
    srcs = [
        "editor.tsx",
        "index.ts",
        "message.tsx",
        "types.ts",
        "validation.ts",
    ],
    author = "Long Ho <holevietlong@gmail.com>",
    description = "An ICU MessageFormat editor UI",
    entry_points = ["index.ts"],
    extra_npm_srcs = ["styles.css"],
    homepage = "https://formatjs.github.io/",
    keywords = [
        "formatjs",
        "i18n",
        "icu",
        "internationalization",
        "localization",
        "react",
        "translation",
    ],
    license = "MIT",
    package_dependency_version_overrides = {
        "@types/react": ">=18.0.0",
        "react": ">=18.0.0",
    },
    package_peer_deps = [
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
    package_types = "index.d.ts",
    repository = "formatjs/formatjs.git",
    side_effects = ["./styles.css"],
    type = "module",
    version = "3.0.28",  # x-release-please-version
    visibility = ["//visibility:public"],
    exports = {
        ".": "./index.js",
        "./styles.css": "./styles.css",
    },
    deps = [
        "//:node_modules/@formatjs/icu-messageformat-parser",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

formatjs_test(
    name = "editor_test",
    srcs = ["editor.test.tsx"],
    dom = True,
    no_copy_to_bin = ["//:package.json"],
    deps = [
        ":editor",
        "//:node_modules/@testing-library/jest-dom",
        "//:node_modules/@testing-library/react",
        "//:node_modules/vitest",
    ],
)
