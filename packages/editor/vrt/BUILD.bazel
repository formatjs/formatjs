# gazelle:ts_enabled false
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@rules_web_e2e//vrt:defs.bzl", "component_visual_test")
load("//tools:tsconfig.bzl", "ESNEXT_SKIP_LIB_CHECK_TSCONFIG", "packages_tsconfig")

npm_link_package(
    name = "node_modules/@rules-web-e2e/vrt",
    src = "@rules_web_e2e//runtime:package",
)

VRT_DEPS = [
    "//:node_modules/react-intl",
    "//packages/editor:editor",
    ":node_modules/@rules-web-e2e/vrt",
    "//:node_modules/@vitejs/plugin-react",
    "//:node_modules/@playwright/test",
    "//:node_modules/playwright",
    "//:node_modules/react",
    "//:node_modules/react-dom",
    "//:node_modules/vite",
]

# Playwright loads .ts configs as ESM when this generated marker is present.
genrule(
    name = "esm_package_json",
    outs = ["package.json"],
    cmd = "echo '{\"type\":\"module\"}' > $@",
)

component_visual_test(
    name = "visual_test",
    srcs = [
        "app.tsx",
        "editor.visual.spec.ts",
        "index.html",
        "shell.tsx",
        "vite.config.ts",
        ":esm_package_json",
    ],
    baselines = glob(
        ["__screenshots__/*.png"],
        allow_empty = True,
    ),
    config = "playwright.config.ts",
    data = [
        ":typecheck",
        "//:root_package_json",
        "//packages/editor:srcs",
        "//packages/editor:vrt_sources",
    ],
    playwright_core = "//:node_modules/playwright-core/dir",
    playwright_test = "//:node_modules/@playwright/test/dir",
    server = ":server.js",
    deps = VRT_DEPS,
)

ts_project(
    name = "typecheck_project",
    srcs = glob([
        "*.ts",
        "*.tsx",
    ]) + ["//packages/editor:vrt_sources"],
    declaration = True,
    no_emit = True,
    resolve_json_module = True,
    root_dir = "..",
    tsconfig = packages_tsconfig(ESNEXT_SKIP_LIB_CHECK_TSCONFIG),
    deps = VRT_DEPS + [
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
    ],
)

filegroup(
    name = "typecheck",
    srcs = [":typecheck_project"],
    output_group = "transitive_typecheck",
)

ts_project(
    name = "server_module",
    srcs = ["server.ts"],
    declaration = True,
    resolve_json_module = True,
    transpiler = "tsc",
    tsconfig = packages_tsconfig(ESNEXT_SKIP_LIB_CHECK_TSCONFIG),
    deps = VRT_DEPS + ["//:node_modules/@types/node"],
)
