load("@aspect_rules_js//js:defs.bzl", "js_library")

# Gazelle maintains source graphs; Bazel builds the shell and compiles browser specs.
# gazelle:map_kind ts_library vrt_library //packages/editor/vrt:defs.bzl
# gazelle:map_kind ts_test vrt_test //packages/editor/vrt:defs.bzl
# gazelle:ts_test_name visual_sources
# gazelle:resolve ts @rules-web-e2e/vrt/server :node_modules/@rules-web-e2e/vrt
# gazelle:resolve ts @rules-web-e2e/vrt :node_modules/@rules-web-e2e/vrt
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@npm//:vite/package_json.bzl", vite_bin = "bin")
load("@rules_web_e2e//component:defs.bzl", "browser_shell", "component_browser_test")
load("@rules_web_e2e//e2e:defs.bzl", "web_e2e_test")
load("@rules_web_e2e//playwright:defs.bzl", "playwright_runtime")
load("@rules_web_e2e//vrt:defs.bzl", "component_visual_test")
load(":defs.bzl", "vrt_library", "vrt_test")

npm_link_package(
    name = "node_modules/@rules-web-e2e/vrt",
    src = "@rules_web_e2e//runtime:package",
)

# The compiled specs, server, and matching module use ESM.
genrule(
    name = "esm_package_json",
    outs = ["package.json"],
    cmd = "echo '{\"type\":\"module\"}' > $@",
)

# The application's build owns Vite/StyleX; browser rules consume its output.
vite_bin.vite(
    name = "bundle",
    srcs = [
        "gallery.html",
        "index.html",
        "reset.css",
        ":esm_package_json",
        ":typecheck",
        ":vrt",
        ":vrt_compiled",
        "//:node_modules/@formatjs/fast-memoize",
        "//:node_modules/@formatjs/icu-messageformat-parser",
        "//:node_modules/@formatjs/icu-skeleton-parser",
        "//:node_modules/@formatjs/intl",
        "//:node_modules/intl-messageformat",
        "//:root_package_json",
        "//packages/editor:srcs",
        "//packages/editor/demo:srcs",
    ],
    args = [
        "build",
        "--config",
        "vite.config.js",
    ],
    chdir = package_name(),
    out_dirs = ["assets"],
)

js_library(
    name = "vrt_matching",
    srcs = ["matching.js"],
    data = [":esm_package_json"],
)

browser_shell(
    name = "editor_shell",
    assets = ":bundle",
    entry_point = "gallery.html",
)

playwright_runtime(
    name = "playwright",
    core = "//:node_modules/playwright-core/dir",
    test = "//:node_modules/@playwright/test/dir",
)

js_library(
    name = "e2e_specs",
    srcs = ["editor.spec.js"],
    data = [":esm_package_json"],
    deps = [":visual_sources_compiled"],
)

js_library(
    name = "component_specs",
    srcs = ["editor.browser.spec.js"],
    data = [":esm_package_json"],
    deps = [":visual_sources_compiled"],
)

js_library(
    name = "editor_server",
    srcs = ["server.js"],
    data = [
        ":bundle",
        ":esm_package_json",
    ],
    deps = [":vrt_compiled"],
)

component_visual_test(
    name = "visual_test",
    baselines = glob(
        ["__screenshots__/*.png"],
        allow_empty = True,
    ),
    matching = ":vrt_matching",
    playwright = ":playwright",
    shell = ":editor_shell",
)

web_e2e_test(
    name = "e2e_test",
    playwright = ":playwright",
    server = ":editor_server",
    tests = ":e2e_specs",
)

component_browser_test(
    name = "component_test",
    playwright = ":playwright",
    shell = ":editor_shell",
    tests = ":component_specs",
)

filegroup(
    name = "typecheck",
    srcs = [
        ":visual_sources_typecheck",
        ":vrt_typecheck",
        "//packages/editor/demo:typecheck",
    ],
    output_group = "transitive_typecheck",
)

vrt_library(
    name = "vrt",
    srcs = [
        "app.tsx",
        "editor.visual.tsx",
        "gallery.tsx",
        "matching.ts",
        "server.ts",
        "shell.tsx",
        "vite.config.ts",
    ],
    tsconfig_types = ["node"],
    visibility = ["//visibility:public"],
    deps = [
        ":node_modules/@rules-web-e2e/vrt",
        "//:node_modules/@formatjs/editor",
        "//:node_modules/@stylexjs/unplugin",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/@vitejs/plugin-react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-intl",
        "//:node_modules/vite",
        "//packages/editor/demo",
    ],
)

vrt_test(
    name = "visual_sources",
    srcs = [
        "editor.browser.spec.tsx",
        "editor.spec.ts",
    ],
    deps = [
        ":vrt",
        "//:node_modules/@playwright/test",
    ],
)
