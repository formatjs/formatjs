# gazelle:ts_enabled false
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@editor_vrt_npm//:defs.bzl", "npm_link_all_packages")
load("@rules_web_e2e//vrt:defs.bzl", "component_visual_test")

npm_link_all_packages(name = "node_modules")

npm_link_package(
    name = "node_modules/@rules-web-e2e/vrt",
    src = "@rules_web_e2e//runtime:package",
)

VRT_DEPS = [
    ":node_modules/@formatjs/icu-messageformat-parser",
    ":node_modules/@material-ui/core",
    ":node_modules/@material-ui/icons",
    ":node_modules/@material-ui/lab",
    ":node_modules/@rules-web-e2e/vrt",
    ":node_modules/@vitejs/plugin-react",
    ":node_modules/@playwright/test",
    ":node_modules/playwright",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":node_modules/react-intl",
    ":node_modules/vite",
]

component_visual_test(
    name = "visual_test",
    srcs = [
        "app.tsx",
        "editor.visual.spec.ts",
        "index.html",
        "package.json",
    ],
    baselines = glob(
        ["__screenshots__/*.png"],
        allow_empty = True,
    ),
    config = "playwright.config.ts",
    data = [
        ":typecheck",
        "//packages/editor:vrt_sources",
    ],
    playwright_core = ":node_modules/playwright-core/dir",
    playwright_test = ":node_modules/@playwright/test/dir",
    server_config = "vite.config.ts",
    vite = ":node_modules/vite/dir",
    deps = VRT_DEPS,
)

ts_project(
    name = "typecheck_project",
    srcs = glob([
        "*.ts",
        "*.tsx",
    ]) + ["//packages/editor:vrt_sources"],
    no_emit = True,
    root_dir = "..",
    tsconfig = "tsconfig.bazel.json",
    deps = VRT_DEPS + [
        ":node_modules/@types/node",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
    ] + ["//packages/editor:vrt_sources"],
)

filegroup(
    name = "typecheck",
    srcs = [":typecheck_project"],
    output_group = "transitive_typecheck",
)
