load("@rules_web_e2e//playwright:browser.bzl", "playwright_browser_installation")

package(default_visibility = ["//packages/editor/vrt:__pkg__"])

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "macos_x64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

# Cache revisions come from the selected Playwright package's browsers.json.
playwright_browser_installation(
    name = "installation",
    chromium = select({
        ":linux_x64": "@rules_browsers_chrome_linux//:info",
        ":macos_arm64": "@rules_browsers_chrome_mac_arm//:info",
        ":macos_x64": "@rules_browsers_chrome_mac//:info",
    }),
    ffmpeg = select({
        ":linux_x64": "@editor_ffmpeg_linux_x64//:files",
        ":macos_arm64": "@editor_ffmpeg_macos_arm64//:files",
        ":macos_x64": "@editor_ffmpeg_macos_x64//:files",
    }),
    playwright = "//packages/editor/vrt:playwright",
)
