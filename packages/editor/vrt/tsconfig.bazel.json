{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {"#packages/*": ["../../*"]}
  },
  "include": [
    "*.ts",
    "*.mts",
    "*.tsx",
    "../demo.tsx",
    "../index.tsx",
    "../message.tsx",
    "../types.ts"
  ],
  "exclude": []
}
