load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("//tools:index.bzl", "package_exports_test")
load("//tools:package_json.bzl", "generate_package_json", "package_json_sync")

generate_package_json(
    package_name = "@formatjs/cli-native-freebsd-x64",
    out = "package.generated.json",
    author = "Long Ho <holevietlong@gmail.com>",
    bugs = "https://github.com/formatjs/formatjs/issues",
    cpu = [
        "x64",
    ],
    description = "Native FormatJS CLI binding for FreeBSD x64.",
    files = [
        "formatjs_cli_napi.node",
    ],
    homepage = "https://github.com/formatjs/formatjs",
    license = "MIT",
    main = "formatjs_cli_napi.node",
    os = [
        "freebsd",
    ],
    repository = "formatjs/formatjs.git",
    version = "1.0.0",  # x-release-please-version
    exports = {
        ".": "./formatjs_cli_napi.node",
    },
)

package_json_sync(
    visibility = ["//visibility:public"],
)

exports_files(
    ["package.json"],
    visibility = ["//visibility:public"],
)

copy_to_bin(
    name = "package_json",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)

copy_file(
    name = "formatjs_cli_napi_node",
    src = "//crates/formatjs_cli_napi:release_node_freebsd_x64",
    out = "formatjs_cli_napi.node",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

npm_package(
    name = "pkg",
    srcs = [
        ":formatjs_cli_napi_node",
        ":package_json",
    ],
    package = "@formatjs/cli-native-freebsd-x64",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

package_exports_test(
    name = "package_exports_test",
    pkg = ":pkg",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
