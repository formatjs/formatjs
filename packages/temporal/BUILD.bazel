    "compare",
    "from",
    "prototype/add",
    "prototype/calendarId",
    "prototype/day",
    "prototype/dayOfWeek",
    "prototype/dayOfYear",
    "prototype/daysInMonth",
    "prototype/daysInWeek",
    "prototype/daysInYear",
    "prototype/epochMilliseconds",
    "prototype/epochNanoseconds",
