            "$(rootpath //tools/test262:validator)",
            "Temporal.ZonedDateTime" if name.startswith("zoned") else "Temporal.PlainYearMonth" if name.startswith("year_month") else "Temporal.PlainMonthDay" if name.startswith("month_day") else "Temporal.PlainDateTime" if name.startswith("plain_date_time") else "Temporal.PlainDate" if name.startswith("plain_date") else "Temporal.PlainTime" if name.startswith("plain_time") else "Temporal.Duration" if name.startswith("duration") else "Temporal.Instant",
        ] + patterns,
        data = [
            "instant-payload.js",
            "tests/hermes-host.sh",
            baseline,
            ":instant_hermes_harness",
            "//native/hermes:hermes_runner",
            "//tools/test262:validator",
