        size = "medium",
        timeout = "long" if suite == "calendars" else "moderate",
        srcs = ["tests/hermes-test262.sh"],
        args = [
            "$(rootpath :instant_hermes_harness)",
            "$(rootpath tests/hermes-host.sh)",
            "$(rootpath //native/hermes/tests:test262_runtime)" if backend in [
                "sdk",
                "typescript",
            ] else "$(rootpath //native/hermes:hermes_runner)",
            "$(rootpath tests/sdk-prelude.js)" if backend == "sdk" else "$(rootpath :typescript-hermes-payload.js)" if backend == "typescript" else "$(rootpath native-iso-payload.js)",
            mode,
            "$(rootpath @hermes//:hermesc)",
            "$(rootpath %s)" % baseline,
            "$(rootpath //tools/test262:validator)",
            "Temporal." + backend + "." + suite,
        ] + patterns,
        data = [
            "tests/sdk-prelude.js" if backend == "sdk" else ":typescript-hermes-payload.js" if backend == "typescript" else "native-iso-payload.js",
            "tests/hermes-host.sh",
            baseline,
            ":instant_hermes_harness",
            "//native/hermes/tests:test262_runtime" if backend in [
                "sdk",
                "typescript",
            ] else "//native/hermes:hermes_runner",
            "//tools/test262:validator",
            "@com_github_tc39_test262//:test262-harness-copy",
            "@com_github_tc39_test262//:test262-temporal-instant-copy",
            "@com_github_tc39_test262//:test262-temporal-staging-copy",
            "@hermes//:hermesc",
