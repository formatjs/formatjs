    ":instant-payload.js",
]

genrule(
    name = "locale-payload",
    srcs = _LOCALE_PRELUDES,
    outs = ["locale-payload.js"],
    # Separate source-map comments and IIFEs across bundle boundaries.
    cmd = "(\n" + "\n".join(["cat $(location %s)\nprintf '\\n;\\n'" % label for label in _LOCALE_PRELUDES]) + "\n) > $@",
)

