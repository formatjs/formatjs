        name = name,
        size = "enormous" if name.startswith("locale_intl") else "medium" if name.startswith("locale_") else "small" if name == "instant_test262" else "large",
        args = [
            "--threads",
            "4",
            "--errorForFailures",
            "--reporter",
            "json",
            "--reporter-keys",
            "file,scenario,result",
            "--test262Dir",
            _TEST262_ROOT,
            "--prelude",
            "$(rootpath locale-realm-prelude.js)" if name.startswith("locale_") else "$(rootpath instant-realm-prelude.js)",
        ] + patterns,
        data = [
            "instant-prelude-source.js",
            "instant-realm-prelude.js",
            "@com_github_tc39_test262//:test262-harness-copy",
            "@com_github_tc39_test262//:test262-temporal-duration-copy",
            "@com_github_tc39_test262//:test262-temporal-installation-copy",
            "@com_github_tc39_test262//:test262-temporal-instant-copy",
            "@com_github_tc39_test262//:test262-temporal-intl-copy",
            "@com_github_tc39_test262//:test262-temporal-month-day-copy",
            "@com_github_tc39_test262//:test262-temporal-now-copy",
            "@com_github_tc39_test262//:test262-temporal-plain-date-copy",
            "@com_github_tc39_test262//:test262-temporal-plain-date-time-copy",
            "@com_github_tc39_test262//:test262-temporal-plain-time-copy",
            "@com_github_tc39_test262//:test262-temporal-year-month-copy",
            "@com_github_tc39_test262//:test262-temporal-zoned-copy",
        ] + ([
            "locale-prelude-source.js",
            "locale-realm-prelude.js",
        ] if name.startswith("locale_") else []),
        env = {"TZ": "UTC"},
        exec_properties = {
            "EstimatedCPU": "4",
            "EstimatedMemory": "2GB",
        },
        node_toolchain = "//tools/test262:node-runtime",
        tags = tags + ["cpu:4"],
    )
    for name, patterns, tags in [
        ("calendars_test262", _CALENDAR_PATTERNS, []),
        ("locale_test262", _LOCALE_PATTERNS, []),
        (
            "locale_intl_test262_full",
            [_TEST262_ROOT + "/test/intl402/Temporal/**/*.js"],
            ["manual"],
        ),
        ("zoned_edges_test262", _ZONED_EDGE_PATTERNS, []),
        ("installation_test262", _INSTALLATION_PATTERNS, []),
