# Current LDML and ICU79 require numeric zero; full diagnostics retain this file.
_LOCALE_PATTERNS = [
    _TEST262_ROOT + "/test/built-ins/Temporal/" + kind + "/prototype/toLocaleString/**/*.js"
    for kind in [
        "Instant",
        "Duration",
        "PlainDate",
        "PlainTime",
        "PlainDateTime",
        "PlainYearMonth",
        "PlainMonthDay",
        "ZonedDateTime",
    ]
] + [
    _TEST262_ROOT + "/test/intl402/Temporal/" + kind + "/prototype/toLocaleString/**/" + ("!(offset-time-zones).js" if kind == "ZonedDateTime" else "*.js")
    for kind in [
        "Instant",
        "Duration",
        "PlainDate",
        "PlainTime",
        "PlainDateTime",
        "PlainYearMonth",
        "PlainMonthDay",
        "ZonedDateTime",
