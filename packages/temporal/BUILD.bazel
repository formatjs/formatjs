        "plain-slots.ts",
        "plain-time.ts",
        "plain-year-month.ts",
        "polyfill.ts",
        "polyfill-force.ts",
        "relative-duration.ts",
        "rounding.ts",
        "short-date-core.ts",
        "should-polyfill.ts",
        "standalone.ts",
        "wasm.ts",
        "wasm-native.ts",
        "wasm-wire.ts",
        "zoned-date-time.ts",
        "zones.ts",
    ],
    author = "Long Ho <holevietlong@gmail.com>",
    bugs = "https://github.com/formatjs/formatjs/issues",
    description = "Temporal implementation",
    entry_point_defines = {
        entry: {
            "import.meta.formatjsTemporalHostTimeZones": "true" if entry in [
                "index.ts",
                "polyfill.ts",
                "polyfill-force.ts",
                "wasm.ts",
            ] else "false",
            "import.meta.formatjsTemporalNativeData": "true" if entry == "wasm-native.ts" else "false",
            "import.meta.formatjsTemporalCompactTimeZones": "false" if entry in [
                "native.ts",
                "wasm-native.ts",
            ] else "true",
            "import.meta.formatjsTemporalHostCalendar": "true" if entry in [
                "index.ts",
                "polyfill.ts",
                "polyfill-force.ts",
                "wasm.ts",
            ] else "false",
        }
        for entry in [
            "index.ts",
            "standalone.ts",
            "native.ts",
            "wasm.ts",
            "wasm-native.ts",
            "polyfill.ts",
            "polyfill-force.ts",
            "should-polyfill.ts",
        ]
    },
    entry_point_external_paths = {
        "index.ts": {"#packages/temporal/native.js": "./native.js"},
        "standalone.ts": {"#packages/temporal/native.js": "./native.js"},
        "wasm.ts": {"#packages/temporal/native.js": "./native.js"},
        "polyfill.ts": {"#packages/temporal/index.js": "./index.js"},
        "polyfill-force.ts": {"#packages/temporal/index.js": "./index.js"},
    },
    entry_points = [
        "index.ts",
        "standalone.ts",
        "native.ts",
        "wasm.ts",
        "wasm-native.ts",
        "polyfill.ts",
        "polyfill-force.ts",
        "should-polyfill.ts",
    ],
    extra_npm_srcs = [
        ":wasm_asset",
        ":wasm_notices",
    ],
    homepage = "https://github.com/formatjs/formatjs#readme",
    license = "MIT AND Unicode-3.0",
    package_types = "index.d.ts",
    private = False,
    repository = "formatjs/formatjs.git",
    side_effects = [
        "./polyfill.js",
        "./polyfill-force.js",
    ],
    tsconfig = packages_tsconfig(ESNEXT_TSCONFIG),
    type = "module",
    types = True,
    version = "1.1.0",  # x-release-please-version
    visibility = ["//visibility:public"],
    exports = {
        ".": "./index.js",
        "./standalone.js": "./standalone.js",
        "./wasm.js": "./wasm.js",
        "./wasm-native.js": "./wasm-native.js",
        "./temporal-backend.wasm": "./temporal-backend.wasm",
        "./polyfill.js": "./polyfill.js",
        "./polyfill-force.js": "./polyfill-force.js",
        "./should-polyfill.js": "./should-polyfill.js",
    },
    deps = [
        "//:node_modules/@formatjs_generated/datetimeformat.calendars",
        "//:node_modules/@formatjs_generated/icu.calendar",
        "//:node_modules/@formatjs_generated/tz",
        "//packages/ecma262-abstract",
        "//packages/ecma402-abstract/Calendar",
        "//packages/ecma402-abstract/DateTimeFormat",
        "//packages/ecma402-abstract/DurationFormat",
        "//packages/ecma402-abstract/types",
    ],
)

