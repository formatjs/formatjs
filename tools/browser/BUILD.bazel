exports_files(["repositories.bzl"])

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "host_browsers",
    actual = select(
        {
            ":linux_x64": "@editor_host_browsers_linux//:browsers",
            ":macos_arm64": "@editor_host_browsers_macos//:browsers",
        },
        no_match_error = "Editor host browsers support Linux x64 and macOS arm64.",
    ),
    visibility = ["//packages/editor/vrt:__pkg__"],
)
