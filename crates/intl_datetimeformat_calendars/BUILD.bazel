load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//packages/intl-datetimeformat:calendar_registry.bzl", "CALENDARS")
load("//tools:index.bzl", "ts_run_binary")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load("//tools/ffi_headers:defs.bzl", "rust_ffi_header")

rust_ffi_header(
    name = "generate_header",
    src = "ffi.rs",
    out = "datetimeformat_calendars.h",
)

cc_library(
    name = "headers",
    hdrs = ["datetimeformat_calendars.h"],
    include_prefix = "formatjs/intl",
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
    deps = ["//crates/intl_datetimeformat:headers"],
)

rust_library(
    name = "intl_datetimeformat_calendars",
    srcs = [
        "arithmetic.rs",
        "compiled.rs",
        "core.rs",
        "date_math.rs",
        "ffi.rs",
        "lib.rs",
        "provider.rs",
        "table_calendar.rs",
        "tables.rs",
    ],
    crate_features = ["provider"],
    crate_name = "formatjs_intl_datetimeformat_calendars",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_datetimeformat",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

COMPILED_DEPS = [
    "//crates/intl_datetimeformat:with_compiled_data",
    "@crates//:serde",
    "@crates//:serde_json",
]

rust_library(
    name = "with_compiled_data",
    srcs = [
        "arithmetic.rs",
        "compiled.rs",
        "core.rs",
        "date_math.rs",
        "ffi.rs",
        "lib.rs",
        "provider.rs",
        "table_calendar.rs",
        "tables.rs",
    ],
    compile_data = [":calendar-data/%s.json" % calendar for calendar in CALENDARS],
    crate_features = [
        "compiled_data",
        "provider",
    ],
    crate_name = "formatjs_intl_datetimeformat_calendars",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_env = {
        "FORMATJS_CALENDAR_%s" % calendar.upper().replace("-", "_"): "$(execpath :calendar-data/%s.json)" % calendar
        for calendar in CALENDARS
    },
    visibility = ["//visibility:public"],
    deps = COMPILED_DEPS,
)

ts_run_binary(
    name = "calendar_data",
    outs = ["calendar-data/%s.json" % calendar for calendar in CALENDARS],
    args = [
        "--outDir",
        package_name() + "/calendar-data",
    ],
    tool = "//crates/intl_datetimeformat_calendars/scripts:data",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "calendar_conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//:__pkg__"],
    deps = [
        ":intl_datetimeformat_calendars",
        "//crates/intl_datetimeformat",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "intl_datetimeformat_calendars_test",
    srcs = ["ffi.test.rs"],
    compile_data = [
        "//crates/intl_datetimeformat:locale-data/en.json",
        "//packages/intl-datetimeformat-calendar-buddhist:locale-data-json/en.json",
        "//packages/intl-datetimeformat-calendar-hebrew:locale-data-json/en.json",
    ],
    crate_name = "intl_datetimeformat_calendars_test",
    edition = "2024",
    rustc_env = {
        "FORMATJS_DATETIME_EN": "$(execpath //crates/intl_datetimeformat:locale-data/en.json)",
        "FORMATJS_BUDDHIST_EN": "$(execpath //packages/intl-datetimeformat-calendar-buddhist:locale-data-json/en.json)",
        "FORMATJS_HEBREW_EN": "$(execpath //packages/intl-datetimeformat-calendar-hebrew:locale-data-json/en.json)",
    },
    deps = [
        ":intl_datetimeformat_calendars",
        "//crates/intl_datetimeformat",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "compiled_calendars_test",
    srcs = ["compiled.test.rs"],
    crate_name = "compiled_calendars_test",
    edition = "2024",
    deps = [
        ":with_compiled_data",
        "//crates/intl_datetimeformat:with_compiled_data",
        "@crates//:serde_json",
    ],  # keep
)

filegroup(
    name = "cargo_sources",
    srcs = glob([
        "*.rs",
        "*.toml",
    ]),
    visibility = ["//crates:__pkg__"],
)

# Gazelle does not resolve cfg(feature = "provider") for this no_std variant.
rust_library(
    name = "calendar_core",
    srcs = [
        "core.rs",
        "date_math.rs",
        "lib.rs",
        "table_calendar.rs",
    ],  # keep
    crate_name = "formatjs_intl_datetimeformat_calendars",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [],  # keep
)

formatjs_rust_test(
    name = "calendar_core_test",
    size = "small",
    srcs = ["core.test.rs"],
    compile_data = ["//conformance-tests/icu4j:temporal_arithmetic_calendar_fixtures"],
    crate_name = "calendar_core_test",
    edition = "2024",
    rustc_env = {"FORMATJS_ARITHMETIC_CALENDARS": "$(execpath //conformance-tests/icu4j:temporal_arithmetic_calendar_fixtures)"},
    deps = [":calendar_core"],  # keep
)

formatjs_rust_test(
    name = "table_calendar_test",
    srcs = ["table_calendar.test.rs"],
    compile_data = [
        "//conformance-tests/calendar-authorities:hko-month-starts.tsv",
        ":calendar-data/chinese.json",
        ":calendar-data/dangi.json",
        ":calendar-data/islamic-umalqura.json",
        "//conformance-tests/icu4j:temporal_table_calendar_fixtures",
    ],
    crate_name = "table_calendar_test",
    edition = "2024",
    rustc_env = {
        "FORMATJS_HKO_CALENDAR": "$(execpath //conformance-tests/calendar-authorities:hko-month-starts.tsv)",
        "FORMATJS_CALENDAR_CHINESE": "$(execpath :calendar-data/chinese.json)",
        "FORMATJS_CALENDAR_DANGI": "$(execpath :calendar-data/dangi.json)",
        "FORMATJS_CALENDAR_ISLAMIC_UMALQURA": "$(execpath :calendar-data/islamic-umalqura.json)",
        "FORMATJS_TABLE_CALENDARS": "$(execpath //conformance-tests/icu4j:temporal_table_calendar_fixtures)",
    },
    deps = [
        ":intl_datetimeformat_calendars",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
