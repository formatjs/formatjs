load("//tools:compile.bzl", "formatjs_library")
load("//tools:index.bzl", "ts_binary")

ts_binary(
    name = "data",
    entry_point = "data.ts",
    tsconfig_types = ["node"],
    visibility = ["//crates/intl_datetimeformat_calendars:__pkg__"],
    deps = [":scripts"],
)

formatjs_library(
    name = "scripts",
    srcs = ["data.ts"],
    tsconfig_types = ["node"],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@formatjs_generated/datetimeformat.calendars",
        "//:node_modules/@formatjs_generated/icu.calendar",
        "//:node_modules/@types/minimist",
        "//:node_modules/@types/node",
        "//:node_modules/minimist",
    ],
)
