load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("//tools:rust_test.bzl", "formatjs_rust_test")

exports_files(
    [
        "Cargo.toml",
        "README.md",
        "lib.rs",
        "formatted_message.rs",
        "argument_types.rs",
    ],
    visibility = ["//visibility:public"],
)

# Keep feature-variant dependency edges explicit.
PROVIDER_TEST_DEPS = [
    "//crates/icu_messageformat_parser",
    "//crates/icu_messageformat:without_compiled_data",
    ":without_compiled_data",
    "@crates//:icu",
    "@crates//:icu_locale",
    "@crates//:icu_provider",
    "@crates//:icu_provider_adapters",
    "@crates//:icu_provider_blob",
]

WITHOUT_COMPILED_DATA_DEPS = [
    "//crates/icu_messageformat:without_compiled_data",
    "@crates//:icu",
    "@crates//:icu_locale",
    "@crates//:icu_provider",
    "@crates//:icu_provider_adapters",
]

rust_library(
    name = "formatjs_intl",
    srcs = [
        "argument_types.rs",
        "formatted_message.rs",
        "lib.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl",
    crate_root = "lib.rs",
    edition = "2024",
    proc_macro_deps = ["//crates/formatjs_intl_macros"],
    visibility = ["//visibility:public"],
    deps = [
        "//crates/icu_messageformat",
        "@crates//:icu",
        "@crates//:icu_locale",
        "@crates//:icu_provider",
        "@crates//:icu_provider_adapters",
    ],
)

formatjs_rust_test(
    name = "formatjs_intl_test",
    size = "small",
    srcs = [
        "argument_types.test.rs",
        "formatted_message.test.rs",
        "lib.test.rs",
        "provider.test.rs",
    ],
    compile_data = ["testdata/en_fr.postcard"],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl_test",
    edition = "2024",
    deps = [
        ":formatjs_intl",
        "//crates/icu_messageformat",
        "//crates/icu_messageformat_parser",
        "@crates//:icu",
        "@crates//:icu_locale",
        "@crates//:icu_provider",
        "@crates//:icu_provider_adapters",
        "@crates//:icu_provider_blob",
        "@crates//:serde_json",
    ],
)

rust_doc_test(
    name = "formatjs_intl_doc_test",
    size = "small",
    crate = ":formatjs_intl",
    crate_features = ["compiled_data"],
)

rust_library(
    name = "without_compiled_data",
    testonly = True,
    srcs = [
        "argument_types.rs",
        "formatted_message.rs",
        "lib.rs",
    ],
    crate_name = "formatjs_intl",
    crate_root = "lib.rs",
    edition = "2024",
    proc_macro_deps = ["//crates/formatjs_intl_macros"],
    visibility = ["//visibility:public"],
    deps = WITHOUT_COMPILED_DATA_DEPS,
)

formatjs_rust_test(
    name = "provider_test",
    size = "small",
    srcs = ["provider.test.rs"],
    compile_data = ["testdata/en_fr.postcard"],
    crate_name = "provider_test",
    edition = "2024",
    deps = PROVIDER_TEST_DEPS,
)
