load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//tools:index.bzl", "ts_run_binary")
load("//tools:rust_test.bzl", "formatjs_rust_test")

ts_run_binary(
    name = "data",
    srcs = ["//:node_modules/@formatjs_generated/cldr.collation"],
    outs = ["collation_data.json"],
    args = [
        "--out",
        "$(rootpath :collation_data.json)",
    ],
    tool = "//crates/intl_collator/scripts:data",
)

rust_library(
    name = "intl_collator",
    srcs = [
        "compare.rs",
        "data.rs",
        "lib.rs",
    ],
    compile_data = [":data"],
    crate_name = "formatjs_intl_collator",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_env = {"FORMATJS_COLLATION_DATA": "$(execpath :data)"},
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_getcanonicallocales",
        "//crates/intl_locale",
        "@crates//:icu_casemap-2.3.0",
        "@crates//:icu_locale_core-2.3.0",
        "@crates//:icu_normalizer-2.3.0",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "intl_collator_test",
    srcs = ["lib.test.rs"],
    crate_name = "intl_collator_test",
    edition = "2024",
    deps = [":intl_collator"],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//crates/intl_collator/tests:__pkg__"],
    deps = [
        ":intl_collator",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
