load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//crates/intl_data:defs.bzl", "compiled_locale_data")
load("//packages/intl-displaynames:locales.generated.bzl", "ALL_LOCALES")
load("//tools:index.bzl", "ts_run_binary")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load("//tools/ffi_headers:defs.bzl", "rust_ffi_header")

rust_ffi_header(
    name = "generate_header",
    src = "ffi.rs",
    out = "displaynames.h",
)

cc_library(
    name = "headers",
    hdrs = ["displaynames.h"],
    include_prefix = "formatjs/intl",
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

ts_run_binary(
    name = "locale_data",
    srcs = ["//packages/intl-displaynames:cldr-raw/%s.json" % locale for locale in ALL_LOCALES],
    outs = ["locale-data/%s.json" % locale for locale in ALL_LOCALES],
    args = [
        "--outDir",
        package_name() + "/locale-data",
    ] + [
        "--cldrFile=packages/intl-displaynames/cldr-raw/%s.json" % locale
        for locale in ALL_LOCALES
    ],
    tool = "//crates/intl_displaynames/scripts:data",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "intl_displaynames",
    srcs = [
        "ffi.rs",
        "lib.rs",
        "registry.rs",
    ],
    crate_name = "formatjs_intl_displaynames",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_data",
        "//crates/intl_getcanonicallocales",
        "//crates/intl_locale",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

COMPILED_DEPS = [
    "//crates/intl_data",
    "//crates/intl_getcanonicallocales",
    "//crates/intl_locale",
    "@crates//:serde",
    "@crates//:serde_json",
]

rust_library(
    name = "with_compiled_data",
    srcs = [
        "ffi.rs",
        "lib.rs",
        "registry.rs",
    ],
    compile_data = [
        ":compiled_locale_data",
        ":compiled_module",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl_displaynames",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_env = {"FORMATJS_COMPILED_LOCALES": "$(execpath :compiled_module)"},
    visibility = ["//visibility:public"],
    deps = COMPILED_DEPS,
)

formatjs_rust_test(
    name = "intl_displaynames_test",
    srcs = [
        "ffi.test.rs",
        "lib.test.rs",
    ],
    crate_name = "intl_displaynames_test",
    edition = "2024",
    deps = [
        ":intl_displaynames",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//crates/intl_displaynames/tests:__pkg__"],
    deps = [
        ":intl_displaynames",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

compiled_locale_data(
    name = "compiled_locale_data",
    srcs = [":locale_data"],
    data_type = "crate::LocaleNames",
    tool = ":compile_locales",
)

filegroup(
    name = "compiled_module",
    srcs = [":compiled_locale_data"],
    output_group = "module",
)

rust_binary(
    name = "compile_locales",
    srcs = ["datagen.rs"],
    crate_name = "compile_locales_displaynames",
    crate_root = "datagen.rs",
    edition = "2024",
    deps = [
        # keep
        ":intl_displaynames",
        "//crates/intl_data_build",
    ],
)
