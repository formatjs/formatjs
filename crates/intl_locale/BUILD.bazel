load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//tools:index.bzl", "generate_src_file")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load("//tools/ffi_headers:defs.bzl", "rust_ffi_header")

rust_ffi_header(
    name = "generate_header",
    src = "ffi.rs",
    out = "locale.h",
)

cc_library(
    name = "headers",
    hdrs = ["locale.h"],
    include_prefix = "formatjs/intl",
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

generate_src_file(
    name = "data",
    src = "data_generated.rs",
    args = ["--matching=$(rootpath //packages/intl-localematcher:language_matching_source)"],
    data = [
        "//:node_modules/@formatjs_generated/cldr.core",
        "//:node_modules/@formatjs_generated/cldr.locale",
        "//packages/intl-localematcher:language_matching_source",
    ],
    tool = "//crates/intl_locale/scripts:data",
)

rust_library(
    name = "intl_locale",
    srcs = [
        "data_generated.rs",
        "ffi.rs",
        "lib.rs",
        "matcher.rs",
    ],
    crate_name = "formatjs_intl_locale",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_getcanonicallocales",
        "@crates//:icu_locale",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "intl_locale_test",
    srcs = [
        "ffi.test.rs",
        "lib.test.rs",
        "matcher.test.rs",
    ],
    crate_name = "intl_locale_test",
    edition = "2024",
    deps = [
        ":intl_locale",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//packages/intl-locale:__pkg__"],
    deps = [
        ":intl_locale",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

filegroup(
    name = "cargo_sources",
    srcs = glob([
        "*.rs",
        "*.toml",
    ]),
    visibility = ["//crates:__pkg__"],
)
