load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//crates/intl_data:defs.bzl", "compiled_locale_data")
load("//packages/intl-pluralrules:locales.generated.bzl", "ALL_LOCALES")
load("//tools:index.bzl", "ts_run_binary")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load("//tools/ffi_headers:defs.bzl", "rust_ffi_header")

rust_ffi_header(
    name = "generate_header",
    src = "ffi.rs",
    out = "pluralrules.h",
)

cc_library(
    name = "headers",
    hdrs = ["pluralrules.h"],
    include_prefix = "formatjs/intl",
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

ts_run_binary(
    name = "locale_data",
    outs = ["locale-data/%s.json" % locale for locale in ALL_LOCALES],
    args = [
        "--outDir",
        "locale-data",
    ] + ["--locale=%s" % locale for locale in ALL_LOCALES],
    chdir = package_name(),
    tool = "//crates/intl_pluralrules/scripts:data",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "intl_pluralrules",
    srcs = [
        "digits.rs",
        "ffi.rs",
        "instance.rs",
        "lib.rs",
        "mathematical.rs",
        "registry.rs",
    ],
    crate_name = "formatjs_intl_pluralrules",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_data",
        "//crates/intl_getcanonicallocales",
        "//crates/intl_locale",
        "@crates//:fixed_decimal",
        "@crates//:icu_plurals",
        "@crates//:icu_provider",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

COMPILED_DEPS = [
    "//crates/intl_data",
    "//crates/intl_getcanonicallocales",
    "//crates/intl_locale",
    "@crates//:fixed_decimal",
    "@crates//:icu_plurals",
    "@crates//:icu_provider",
    "@crates//:serde",
    "@crates//:serde_json",
]

rust_library(
    name = "with_compiled_data",
    srcs = [
        "digits.rs",
        "ffi.rs",
        "instance.rs",
        "lib.rs",
        "mathematical.rs",
        "registry.rs",
    ],
    compile_data = [
        ":compiled_locale_data",
        ":compiled_module",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl_pluralrules",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_env = {"FORMATJS_COMPILED_LOCALES": "$(execpath :compiled_module)"},
    visibility = ["//visibility:public"],
    deps = COMPILED_DEPS,
)

formatjs_rust_test(
    name = "intl_pluralrules_test",
    srcs = [
        "digits.test.rs",
        "ffi.test.rs",
        "instance.test.rs",
        "lib.test.rs",
        "registry.test.rs",
    ],
    crate_name = "intl_pluralrules_test",
    edition = "2024",
    deps = [
        ":intl_pluralrules",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "registration",
    srcs = ["registration.rs"],
    crate_name = "registration",
    crate_root = "registration.rs",
    edition = "2024",
    visibility = ["//crates/intl_pluralrules/tests:__pkg__"],
    deps = [
        ":intl_pluralrules",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//crates/intl_pluralrules/tests:__pkg__"],
    deps = [
        ":intl_pluralrules",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

compiled_locale_data(
    name = "compiled_locale_data",
    srcs = [":locale_data"],
    data_type = "crate::LocaleRules",
    tool = ":compile_locales",
    visibility = ["//crates:__pkg__"],
)

filegroup(
    name = "compiled_module",
    srcs = [":compiled_locale_data"],
    output_group = "module",
)

rust_binary(
    name = "compile_locales",
    srcs = ["datagen.rs"],
    crate_name = "compile_locales_pluralrules",
    crate_root = "datagen.rs",
    edition = "2024",
    visibility = ["//crates/intl_data_build:__pkg__"],
    deps = [
        # keep
        ":intl_pluralrules",
        "//crates/intl_data_build",
    ],
)

filegroup(
    name = "cargo_sources",
    srcs = glob([
        "*.rs",
        "*.toml",
    ]),
    visibility = ["//crates:__pkg__"],
)
