load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//packages/intl-pluralrules:locales.generated.bzl", "ALL_LOCALES")
load("//tools:index.bzl", "ts_run_binary")
load("//tools:rust_test.bzl", "formatjs_rust_test")

ts_run_binary(
    name = "locale_data",
    outs = ["locale-data/%s.json" % locale for locale in ALL_LOCALES],
    args = [
        "--outDir",
        "locale-data",
    ] + ["--locale=%s" % locale for locale in ALL_LOCALES],
    chdir = package_name(),
    tool = "//crates/intl_pluralrules/scripts:data",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "intl_pluralrules",
    srcs = ["lib.rs"],
    crate_name = "formatjs_intl_pluralrules",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_getcanonicallocales",
        "@crates//:fixed_decimal",
        "@crates//:icu_plurals",
        "@crates//:icu_provider",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "intl_pluralrules_test",
    srcs = ["lib.test.rs"],
    crate_name = "intl_pluralrules_test",
    edition = "2024",
    deps = [":intl_pluralrules"],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//crates/intl_pluralrules/tests:__pkg__"],
    deps = [
        ":intl_pluralrules",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
