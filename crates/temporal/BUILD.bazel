load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("//tools:index.bzl", "generate_src_file")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load(":wasm.bzl", "temporal_wasm")

# gazelle:ignore
rust_shared_library(
    name = "wasm_core",
    srcs = ["wasm.rs"],
    crate_name = "formatjs_temporal_wasm",
    crate_root = "wasm.rs",
    edition = "2024",
    rustc_flags = [
        "-Copt-level=z",
        "-Cstrip=symbols",
        "-Cpanic=abort",
    ],
    target_compatible_with = ["@platforms//cpu:wasm32"],
    deps = [":temporal"],
)

temporal_wasm(
    name = "wasm",
    srcs = [":wasm_core"],
    outs = ["temporal-core.wasm"],
    cmd = "cp $< $@",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "temporal",
    srcs = [
        "calendar_difference.rs",
        "calendar_provider.rs",
        "date.rs",
        "duration.rs",
        "format.rs",
        "identifiers_generated.rs",
        "iso.rs",
        "lib.rs",
        "now.rs",
        "parse.rs",
        "plain_relative.rs",
        "relative_duration.rs",
        "rounding.rs",
        "short_dates.rs",
        "time.rs",
        "timezone.rs",
        "timezone_identity.rs",
        "zoned.rs",
        "zoned_difference.rs",
    ],
    crate_name = "formatjs_temporal",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = ["//crates/intl_datetimeformat_calendars:calendar_core"],
)

formatjs_rust_test(
    name = "public_calendar_test",
    size = "small",
    srcs = ["calendar.test.rs"],
    compile_data = [
        "//conformance-tests/icu4j:temporal_short_calendar_fixtures",
        "//conformance-tests/icu4j:temporal_arithmetic_calendar_fixtures",
        "//conformance-tests/icu4j:temporal_table_calendar_fixtures",
        "//crates/intl_datetimeformat_calendars:calendar-data/chinese.json",
        "//crates/intl_datetimeformat_calendars:calendar-data/dangi.json",
        "//crates/intl_datetimeformat_calendars:calendar-data/islamic-umalqura.json",
    ],
    edition = "2024",
    rustc_env = {
        "FORMATJS_SHORT_CALENDARS": "$(execpath //conformance-tests/icu4j:temporal_short_calendar_fixtures)",
        "FORMATJS_ARITHMETIC_CALENDARS": "$(execpath //conformance-tests/icu4j:temporal_arithmetic_calendar_fixtures)",
        "FORMATJS_TABLE_CALENDARS": "$(execpath //conformance-tests/icu4j:temporal_table_calendar_fixtures)",
        "FORMATJS_CALENDAR_CHINESE": "$(execpath //crates/intl_datetimeformat_calendars:calendar-data/chinese.json)",
        "FORMATJS_CALENDAR_DANGI": "$(execpath //crates/intl_datetimeformat_calendars:calendar-data/dangi.json)",
        "FORMATJS_CALENDAR_ISLAMIC_UMALQURA": "$(execpath //crates/intl_datetimeformat_calendars:calendar-data/islamic-umalqura.json)",
    },
    deps = [
        ":temporal",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "temporal_test",
    size = "small",
    srcs = ["lib.test.rs"],
    compile_data = [
        "//conformance-tests/icu4j:temporal_arithmetic_calendar_fixtures",
        "//conformance-tests/icu4j:temporal_plain_relative_fixtures",
        "//conformance-tests/icu4j:temporal_timezone_identity_fixtures",
        "//conformance-tests/icu4j:temporal_zoned_difference_fixtures",
        "//conformance-tests/icu4j:temporal_zoned_rounding_fixtures",
        "//packages/intl-datetimeformat:tz_all_json",
        "//conformance-tests/icu4j:temporal_transition_fixtures",
        "//conformance-tests/icu4j:temporal_timezone_fixtures",
        "//conformance-tests/icu4j:temporal_short_date_fixtures",
        "//conformance-tests/icu4j:temporal_date_arithmetic_fixtures",
        "//packages/temporal:plain_time_string_fixtures",
        "//conformance-tests/icu4j:temporal_time_fixtures",
        "//packages/temporal:instant_string_fixtures",
        "//conformance-tests/icu4j:temporal_rounding_fixtures",
        "//conformance-tests/icu4j:temporal_duration_fixtures",
        "//conformance-tests/icu4j:temporal_iso_fixtures",
    ],
    edition = "2024",
    rustc_env = {
        "FORMATJS_ARITHMETIC_CALENDARS": "$(execpath //conformance-tests/icu4j:temporal_arithmetic_calendar_fixtures)",
        "FORMATJS_TEMPORAL_PLAIN_RELATIVE": "$(execpath //conformance-tests/icu4j:temporal_plain_relative_fixtures)",
        "FORMATJS_TEMPORAL_TZ_IDENTITIES": "$(execpath //conformance-tests/icu4j:temporal_timezone_identity_fixtures)",
        "FORMATJS_TEMPORAL_ZONED_ROUNDING": "$(execpath //conformance-tests/icu4j:temporal_zoned_rounding_fixtures)",
        "FORMATJS_TEMPORAL_ZONED_DIFFERENCE": "$(execpath //conformance-tests/icu4j:temporal_zoned_difference_fixtures)",
        "FORMATJS_TEMPORAL_TRANSITIONS": "$(execpath //conformance-tests/icu4j:temporal_transition_fixtures)",
        "FORMATJS_TEMPORAL_TZ_DATA": "$(execpath //packages/intl-datetimeformat:tz_all_json)",
        "FORMATJS_TEMPORAL_TIMEZONE": "$(execpath //conformance-tests/icu4j:temporal_timezone_fixtures)",
        "FORMATJS_TEMPORAL_SHORT_DATES": "$(execpath //conformance-tests/icu4j:temporal_short_date_fixtures)",
        "FORMATJS_TEMPORAL_DATE_ARITHMETIC": "$(execpath //conformance-tests/icu4j:temporal_date_arithmetic_fixtures)",
        "FORMATJS_TEMPORAL_TIME_STRINGS": "$(execpath //packages/temporal:plain_time_string_fixtures)",
        "FORMATJS_TEMPORAL_TIME": "$(execpath //conformance-tests/icu4j:temporal_time_fixtures)",
        "FORMATJS_TEMPORAL_ROUNDING": "$(execpath //conformance-tests/icu4j:temporal_rounding_fixtures)",
        "FORMATJS_TEMPORAL_STRINGS": "$(execpath //packages/temporal:instant_string_fixtures)",
        "FORMATJS_TEMPORAL_DURATION": "$(execpath //conformance-tests/icu4j:temporal_duration_fixtures)",
        "FORMATJS_TEMPORAL_ISO": "$(execpath //conformance-tests/icu4j:temporal_iso_fixtures)",
    },
    deps = [
        ":temporal",
        "@crates//:serde_json",
    ],
)

generate_src_file(
    name = "identifiers",
    src = "identifiers_generated.rs",
    data = ["//:node_modules/@formatjs_generated/tz"],
    tool = "//crates/temporal/scripts:identifiers",
)
