    },
    deps = [
        ":with_time_zones",
        "@crates//:serde_json",
    ],  # keep
)

generate_src_file(
    name = "identifiers",
    src = "identifiers_generated.rs",
    data = ["//:node_modules/@formatjs_generated/tz"],
    tool = "//crates/temporal/scripts:identifiers",
)

ts_run_binary(
    name = "time_zones_data",
    outs = ["timezones_data.rs"],
    args = [
        "--out",
        "$(rootpath timezones_data.rs)",
    ],
    tool = "//crates/temporal/scripts:timezones",
    use_execroot_entry_point = False,
    visibility = ["//crates:__pkg__"],
)

rust_library(
    name = "with_time_zones",
    srcs = [
        "calendar_difference.rs",
        "calendar_provider.rs",
        "calendar_registry.rs",
        "context.rs",
        "date.rs",
        "duration.rs",
        "format.rs",
        "identifiers_generated.rs",
        "iso.rs",
        "lib.rs",
        "now.rs",
        "parse.rs",
        "plain_relative.rs",
        "relative_duration.rs",
        "rounding.rs",
        "short_dates.rs",
        "time.rs",
        "timezone.rs",
        "timezone_identity.rs",
        "timezone_registry.rs",
        "zoned.rs",
        "zoned_difference.rs",
        "zoned_string.rs",
    ],  # keep
    compile_data = [":time_zones_data"],
    crate_features = ["compiled_time_zones"],
    crate_name = "formatjs_temporal",
