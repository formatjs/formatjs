load("//tools:compile.bzl", "formatjs_library")
load("//tools:index.bzl", "ts_binary")

ts_binary(
    name = "timezones",
    entry_point = "timezones.ts",
    tsconfig_types = ["node"],
    visibility = ["//crates/intl_datetimeformat:__pkg__"],
    deps = [":scripts"],
)

ts_binary(
    name = "locales",
    entry_point = "locales.ts",
    tsconfig_types = ["node"],
    visibility = ["//crates/intl_datetimeformat:__pkg__"],
    deps = [":scripts"],
)

formatjs_library(
    name = "scripts",
    srcs = [
        "locales.ts",
        "timezones.ts",
    ],
    tsconfig_types = ["node"],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@formatjs_generated/cldr.supported-locales",
        "//:node_modules/@formatjs_generated/tz",
        "//:node_modules/@types/minimist",
        "//:node_modules/@types/node",
        "//:node_modules/minimist",
    ],
)
