load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//packages/intl-datetimeformat:locales.generated.bzl", "ALL_LOCALES")
load("//tools:index.bzl", "ts_run_binary")
load("//tools:rust_test.bzl", "formatjs_rust_test")

ts_run_binary(
    name = "timezone_links",
    outs = ["timezone-links.json"],
    args = [
        "--out",
        "$(rootpath timezone-links.json)",
    ],
    tool = "//crates/intl_datetimeformat/scripts:timezones",
)

ts_run_binary(
    name = "locale_aliases",
    outs = ["locale-aliases.json"],
    args = [
        "--out",
        "$(rootpath locale-aliases.json)",
    ],
    tool = "//crates/intl_datetimeformat/scripts:locales",
)

ts_run_binary(
    name = "locale_data",
    srcs = ["//crates/intl_numberformat:locale_data"] + [
        "//packages/intl-datetimeformat:locale-data-json/%s.json" % locale
        for locale in ALL_LOCALES
    ],
    outs = ["locale-data/%s.json" % locale for locale in ALL_LOCALES],
    args = [
        "--outDir",
        package_name() + "/locale-data",
        "--numberDir",
        "crates/intl_numberformat/locale-data",
    ] + ["--cldrFile=packages/intl-datetimeformat/locale-data-json/%s.json" % locale for locale in ALL_LOCALES],
    tool = "//crates/intl_datetimeformat/scripts:data",
    visibility = ["//visibility:public"],
)

rust_library(
    name = "intl_datetimeformat",
    srcs = [
        "calendar.rs",
        "civil.rs",
        "data.rs",
        "fields.rs",
        "lib.rs",
        "locale_patterns.rs",
        "matching.rs",
        "numbers.rs",
        "pattern.rs",
        "registry.rs",
        "render.rs",
        "selection.rs",
        "timezone.rs",
    ],
    compile_data = [
        ":timezone_links",
        ":locale_aliases",
    ],
    crate_name = "formatjs_intl_datetimeformat",
    crate_root = "lib.rs",
    edition = "2024",
    rustc_env = {
        "FORMATJS_TIMEZONE_LINKS": "$(execpath :timezone_links)",
        "FORMATJS_DATETIME_LOCALE_ALIASES": "$(execpath :locale_aliases)",
    },
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_getcanonicallocales",
        "//crates/intl_locale",
        "//crates/intl_numberformat",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "intl_datetimeformat_test",
    srcs = [
        "calendar.test.rs",
        "lib.test.rs",
        "pattern.test.rs",
        "timezone.test.rs",
    ],
    crate_name = "intl_datetimeformat_test",
    edition = "2024",
    deps = [":intl_datetimeformat"],
)

rust_binary(
    name = "civil_conformance",
    srcs = ["civil_conformance.rs"],
    crate_name = "civil_conformance",
    crate_root = "civil_conformance.rs",
    edition = "2024",
    visibility = ["//crates/intl_datetimeformat/tests:__pkg__"],
    deps = [":intl_datetimeformat"],
)

filegroup(
    name = "timezone_data",
    srcs = [
        "//packages/intl-datetimeformat:tz_all_json",
        "//packages/intl-datetimeformat:tz_golden_json",
    ],
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "timezone_conformance",
    srcs = ["timezone_conformance.rs"],
    crate_name = "timezone_conformance",
    crate_root = "timezone_conformance.rs",
    edition = "2024",
    visibility = ["//packages/intl-datetimeformat:__pkg__"],
    deps = [
        ":intl_datetimeformat",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "pattern_conformance",
    srcs = ["pattern_conformance.rs"],
    crate_name = "pattern_conformance",
    crate_root = "pattern_conformance.rs",
    edition = "2024",
    visibility = ["//:__pkg__"],
    deps = [
        ":intl_datetimeformat",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
