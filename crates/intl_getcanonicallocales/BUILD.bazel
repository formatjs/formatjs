load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("//tools:index.bzl", "generate_src_file")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load("//tools/ffi_headers:defs.bzl", "rust_ffi_header")

rust_ffi_header(
    name = "generate_header",
    src = "lib.rs",
    out = "canonicalize.h",
)

generate_src_file(
    name = "aliases",
    src = "aliases_generated.rs",
    data = [
        "//:node_modules/cldr-bcp47",
        "//:node_modules/cldr-core",
    ],
    tool = "//crates/intl_getcanonicallocales/scripts:aliases",
)

rust_library(
    name = "intl_getcanonicallocales",
    srcs = [
        "aliases_generated.rs",
        "lib.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl_getcanonicallocales",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:icu_locale",
        "@crates//:icu_provider",
    ],
)

rust_static_library(
    name = "intl_getcanonicallocales_native",
    srcs = [
        "aliases_generated.rs",
        "lib.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl_getcanonicallocales",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:icu_locale-2.3.1",
        "@crates//:icu_provider-2.3.1",
    ],
)

formatjs_rust_test(
    name = "intl_getcanonicallocales_test",
    size = "small",
    srcs = [
        "aliases_generated.rs",
        "lib.rs",
        "provider_tests.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_intl_getcanonicallocales",
    crate_root = "lib.rs",
    edition = "2024",
    deps = [
        "@crates//:icu_locale",
        "@crates//:icu_provider",
    ],
)

rust_library(
    name = "without_compiled_data",
    srcs = [
        "aliases_generated.rs",
        "lib.rs",
    ],
    crate_name = "formatjs_intl_getcanonicallocales",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:icu_locale",
        "@crates//:icu_provider",
    ],
)

formatjs_rust_test(
    name = "provider_test",
    size = "small",
    srcs = [
        "aliases_generated.rs",
        "lib.rs",
        "provider_tests.rs",
    ],
    crate_name = "formatjs_intl_getcanonicallocales",
    crate_root = "lib.rs",
    edition = "2024",
    deps = [
        "@crates//:icu_locale",
        "@crates//:icu_provider",
    ],
)

cc_library(
    name = "headers",
    hdrs = ["canonicalize.h"],
    include_prefix = "formatjs/intl",
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cargo_sources",
    srcs = glob([
        "*.rs",
        "*.toml",
    ]),
    visibility = ["//crates:__pkg__"],
)
