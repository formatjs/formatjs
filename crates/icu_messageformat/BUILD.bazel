load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

exports_files(
    [
        "Cargo.toml",
        "README.md",
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "provider_tests.rs",
        "value.rs",
    ],
    visibility = ["//visibility:public"],
)

# Keep feature-variant dependency edges explicit.
WITHOUT_COMPILED_DATA_DEPS = [
    "//crates/icu_messageformat_parser",
    "//crates/icu_skeleton_parser",
    "@crates//:fixed_decimal",
    "@crates//:icu",
    "@crates//:icu_provider",
]

rust_library(
    name = "icu_messageformat",
    srcs = [
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "value.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_icu_messageformat",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/icu_messageformat_parser",
        "//crates/icu_skeleton_parser",
        "@crates//:fixed_decimal-0.7.2",
        "@crates//:icu-2.3.1",
        "@crates//:icu_provider-2.3.1",
    ],
)

rust_test(
    name = "icu_messageformat_test",
    size = "small",
    srcs = [
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "provider_tests.rs",
        "value.rs",
    ],
    compile_data = ["testdata/fr_pl.postcard"],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_icu_messageformat",
    crate_root = "lib.rs",
    edition = "2024",
    deps = [
        "//crates/icu_messageformat_parser",
        "//crates/icu_skeleton_parser",
        "@crates//:fixed_decimal-0.7.2",
        "@crates//:icu-2.3.1",
        "@crates//:icu_provider-2.3.1",
        "@crates//:icu_provider_blob-2.3.0",
    ],
)

rust_library(
    name = "without_compiled_data",
    testonly = True,
    srcs = [
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "value.rs",
    ],
    crate_name = "formatjs_icu_messageformat",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = WITHOUT_COMPILED_DATA_DEPS,
)

rust_test(
    name = "provider_test",
    size = "small",
    srcs = [
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "provider_tests.rs",
        "value.rs",
    ],
    compile_data = ["testdata/fr_pl.postcard"],
    crate_name = "formatjs_icu_messageformat",
    crate_root = "lib.rs",
    edition = "2024",
    deps = WITHOUT_COMPILED_DATA_DEPS + ["@crates//:icu_provider_blob"],
)
