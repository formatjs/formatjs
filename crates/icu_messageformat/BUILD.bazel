load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//tools:rust_test.bzl", "formatjs_rust_test")

exports_files(
    [
        "Cargo.toml",
        "README.md",
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "value.rs",
    ],
    visibility = ["//visibility:public"],
)

# Keep feature-variant dependency edges explicit.
PROVIDER_TEST_DEPS = [
    "//crates/icu_messageformat_parser",
    "//crates/icu_skeleton_parser",
    ":without_compiled_data",
    "@crates//:icu",
    "@crates//:icu_locale",
    "@crates//:icu_provider",
    "@crates//:icu_provider_adapters",
    "@crates//:icu_provider_blob",
]

WITHOUT_COMPILED_DATA_DEPS = [
    "//crates/icu_messageformat_parser",
    "//crates/icu_skeleton_parser",
    "@crates//:fixed_decimal",
    "@crates//:icu",
    "@crates//:icu_provider",
    "@crates//:writeable",
]

rust_library(
    name = "icu_messageformat",
    srcs = [
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "value.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_icu_messageformat",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/icu_messageformat_parser",
        "//crates/icu_skeleton_parser",
        "@crates//:fixed_decimal",
        "@crates//:icu",
        "@crates//:icu_provider",
        "@crates//:writeable-0.6.4",
    ],
)

formatjs_rust_test(
    name = "icu_messageformat_test",
    size = "small",
    srcs = [
        "lib.test.rs",
        "provider.test.rs",
    ],
    compile_data = ["testdata/fr_pl.postcard"],
    crate_features = ["compiled_data"],
    crate_name = "icu_messageformat_test",
    edition = "2024",
    deps = [
        ":icu_messageformat",
        "//crates/icu_messageformat_parser",
        "//crates/icu_skeleton_parser",
        "@crates//:icu",
        "@crates//:icu_provider",
        "@crates//:icu_provider_blob",
    ],
)

rust_library(
    name = "without_compiled_data",
    testonly = True,
    srcs = [
        "error.rs",
        "formatter.rs",
        "lib.rs",
        "value.rs",
    ],
    crate_name = "formatjs_icu_messageformat",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = WITHOUT_COMPILED_DATA_DEPS,
)

formatjs_rust_test(
    name = "provider_test",
    size = "small",
    srcs = ["provider.test.rs"],
    compile_data = ["testdata/fr_pl.postcard"],
    crate_name = "provider_test",
    edition = "2024",
    deps = PROVIDER_TEST_DEPS,
)
