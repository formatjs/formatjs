load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//tools:rust_test.bzl", "formatjs_rust_test")
load(
    ":release_binary.bzl",
    "release_binary_darwin_arm64",
    "release_binary_linux_arm64",
    "release_binary_linux_x64",
    "release_binary_windows_x64",
)

FORMATJS_CLI_VERSION = "1.8.2"  # x-release-please-version

exports_files(
    [
        "Cargo.toml",
        "lib.rs",
        "main.rs",
        "python_extractor.rs",
        "rust_extractor.rs",
        "extract.rs",
        "extractor.rs",
        "compile.rs",
        "compile_folder.rs",
        "verify.rs",
        "id_generator.rs",
        "formatters/mod.rs",
        "formatters/default.rs",
        "formatters/simple.rs",
        "formatters/transifex.rs",
        "formatters/smartling.rs",
        "formatters/lokalise.rs",
        "formatters/crowdin.rs",
    ],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "formatjs_cli_lib",
    srcs = [
        "compile.rs",
        "compile_folder.rs",
        "extract.rs",
        "extractor.rs",
        "formatters/crowdin.rs",
        "formatters/default.rs",
        "formatters/lokalise.rs",
        "formatters/mod.rs",
        "formatters/simple.rs",
        "formatters/smartling.rs",
        "formatters/transifex.rs",
        "id_generator.rs",
        "lib.rs",
        "python_extractor.rs",
        "rust_extractor.rs",
        "verify.rs",
    ],
    crate_name = "formatjs_cli",
    crate_root = "lib.rs",
    edition = "2024",
    version = FORMATJS_CLI_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        "//crates/icu_messageformat_parser",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:fast-glob",
        "@crates//:hex",
        "@crates//:md-5",
        "@crates//:oxc",
        "@crates//:oxc_allocator",
        "@crates//:oxc_ast",
        "@crates//:oxc_data_structures",
        "@crates//:oxc_parser",
        "@crates//:oxc_span",
        "@crates//:proc-macro2",
        "@crates//:rayon",
        "@crates//:ruff_python_ast",
        "@crates//:ruff_python_parser",
        "@crates//:ruff_text_size",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha1",
        "@crates//:sha2",
        "@crates//:syn",
        "@crates//:walkdir",
    ],
)

# Base rust binary (builds for host platform)
rust_binary(
    name = "formatjs_cli",
    srcs = [
        "main.rs",
    ],
    crate_name = "formatjs",
    crate_root = "main.rs",
    edition = "2024",
    version = FORMATJS_CLI_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        ":formatjs_cli_lib",
        "@crates//:anyhow",
        "@crates//:clap",
    ],
)

formatjs_rust_test(
    name = "formatjs_cli_test",
    size = "small",
    srcs = [
        "compile.test.rs",
        "compile_folder.test.rs",
        "extract.test.rs",
        "extractor.test.rs",
        "formatters/crowdin.test.rs",
        "formatters/default.test.rs",
        "formatters/lokalise.test.rs",
        "formatters/mod.test.rs",
        "formatters/simple.test.rs",
        "formatters/smartling.test.rs",
        "formatters/transifex.test.rs",
        "id_generator.test.rs",
        "main.test.rs",
        "python_extractor.test.rs",
        "rust_extractor.test.rs",
        "verify.test.rs",
    ],
    crate_name = "formatjs_cli_test",
    data = [
        ":formatjs_cli",
        "//packages/ts-transformer:test_fixtures",
    ],
    edition = "2024",
    env = {"FORMATJS_TEST_CLI": "$(rootpath :formatjs_cli)"},
    version = FORMATJS_CLI_VERSION,
    deps = [
        ":formatjs_cli_lib",
        "@crates//:anyhow",
        "@crates//:oxc_span",
        "@crates//:ruff_python_ast",
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
)

# Alias for convenience (defaults to host platform)
alias(
    name = "formatjs",
    actual = ":formatjs_cli",
    visibility = ["//visibility:public"],
)

# Release targets - these build for the current platform and copy to release directory
# Use --platforms flag to build for different platforms:
#   macOS: bazel build --platforms=//crates/formatjs_cli/platforms:darwin_arm64 //crates/formatjs_cli:release_binary
#   Linux: bazel build --platforms=//crates/formatjs_cli/platforms:linux_x86_64 //crates/formatjs_cli:release_binary
#   Linux ARM64: bazel build --platforms=//crates/formatjs_cli/platforms:linux_aarch64 //crates/formatjs_cli:release_binary

genrule(
    name = "release_binary",
    srcs = [":formatjs_cli"],
    outs = ["formatjs_cli_release"],
    cmd = "cp $< $@ && chmod +x $@",
    visibility = ["//visibility:public"],
)

release_binary_linux_x64(
    name = "release_binary_linux_x64",
    srcs = [":formatjs_cli"],
    outs = ["formatjs_cli_linux_x64"],
    cmd = "cp $< $@ && chmod +x $@",
    visibility = ["//visibility:public"],
)

release_binary_linux_arm64(
    name = "release_binary_linux_arm64",
    srcs = [":formatjs_cli"],
    outs = ["formatjs_cli_linux_arm64"],
    cmd = "cp $< $@ && chmod +x $@",
    visibility = ["//visibility:public"],
)

release_binary_darwin_arm64(
    name = "release_binary_darwin_arm64",
    srcs = [":formatjs_cli"],
    outs = ["formatjs_cli_darwin_arm64"],
    cmd = "cp $< $@ && chmod +x $@",
    visibility = ["//visibility:public"],
)

release_binary_windows_x64(
    name = "release_binary_windows_x64",
    srcs = [":formatjs_cli"],
    outs = ["formatjs_cli_win32_x64.exe"],
    cmd = "cp $< $@",
    cmd_ps = "Copy-Item -Path '$(location :formatjs_cli)' -Destination '$@'",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "release_binaries",
    srcs = [
        ":release_binary_darwin_arm64",
        ":release_binary_linux_arm64",
        ":release_binary_linux_x64",
        ":release_binary_windows_x64",
    ],
    visibility = ["//visibility:public"],
)
