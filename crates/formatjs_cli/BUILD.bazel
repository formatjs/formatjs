# Base rust binary (builds for host platform)
rust_binary(
    name = "formatjs_cli",
    srcs = [
        "src/main.rs",
    ],
    crate_name = "formatjs",
    crate_root = "src/main.rs",
    edition = "2024",
    version = FORMATJS_CLI_VERSION,
    visibility = ["//visibility:public"],
    deps = [
        ":formatjs_cli_lib",
        "@crates//:anyhow-1.0.104",
        "@crates//:clap-4.6.7",
    ],
)

