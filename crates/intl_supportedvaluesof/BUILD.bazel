load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("//tools:index.bzl", "generate_src_file")
load("//tools:rust_test.bzl", "formatjs_rust_test")

generate_src_file(
    name = "values",
    src = "values_generated.rs",
    data = [
        "//:node_modules/@formatjs_generated/cldr.collation",
        "//:node_modules/@formatjs_generated/cldr.number",
        "//:node_modules/@formatjs_generated/cldr.supported-values",
    ],
    tool = "//crates/intl_supportedvaluesof/scripts:values",
)

rust_library(
    name = "intl_supportedvaluesof",
    srcs = [
        "ffi.rs",
        "lib.rs",
        "values_generated.rs",
    ],
    crate_name = "formatjs_intl_supportedvaluesof",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_static_library(
    name = "intl_supportedvaluesof_native",
    srcs = [
        "ffi.rs",
        "lib.rs",
        "values_generated.rs",
    ],
    crate_name = "formatjs_intl_supportedvaluesof",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "headers",
    hdrs = ["supported_values.h"],
    include_prefix = "formatjs/intl",
    strip_include_prefix = ".",
    visibility = ["//visibility:public"],
)

formatjs_rust_test(
    name = "intl_supportedvaluesof_test",
    srcs = [
        "ffi.test.rs",
        "lib.test.rs",
    ],
    crate_name = "intl_supportedvaluesof_test",
    edition = "2024",
    deps = [":intl_supportedvaluesof"],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//packages/intl-supportedvaluesof:__pkg__"],
    deps = [
        ":intl_supportedvaluesof",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
