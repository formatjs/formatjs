load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//tools:rust_test.bzl", "formatjs_rust_test")

rust_library(
    name = "intl_durationformat",
    srcs = [
        "lib.rs",
        "options.rs",
        "record.rs",
        "render.rs",
        "unit.rs",
    ],
    crate_name = "formatjs_intl_durationformat",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/intl_listformat",
        "//crates/intl_numberformat",
        "@crates//:serde",
    ],
)

rust_binary(
    name = "conformance",
    srcs = ["conformance.rs"],
    crate_name = "conformance",
    crate_root = "conformance.rs",
    edition = "2024",
    visibility = ["//crates/intl_durationformat/tests:__pkg__"],
    deps = [
        ":intl_durationformat",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)

formatjs_rust_test(
    name = "intl_durationformat_test",
    srcs = [
        "options.test.rs",
        "record.test.rs",
        "render.test.rs",
    ],
    compile_data = [
        "//crates/intl_numberformat:locale-data/en.json",
        "//crates/intl_listformat:locale-data/en.json",
        "//crates/intl_listformat:locale-data/ja.json",
    ],
    crate_name = "intl_durationformat_test",
    edition = "2024",
    rustc_env = {
        "FORMATJS_DURATION_NUMBER_EN": "$(execpath //crates/intl_numberformat:locale-data/en.json)",
        "FORMATJS_DURATION_LIST_EN": "$(execpath //crates/intl_listformat:locale-data/en.json)",
        "FORMATJS_DURATION_LIST_JA": "$(execpath //crates/intl_listformat:locale-data/ja.json)",
    },
    deps = [
        ":intl_durationformat",
        "@crates//:serde_json",
    ],
)
