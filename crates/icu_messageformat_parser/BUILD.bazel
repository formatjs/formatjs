load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//tools:index.bzl", "generate_src_file")
load("//tools:rust_test.bzl", "formatjs_rust_test")

exports_files(
    [
        "Cargo.toml",
        "date_time_pattern_generator.rs",
        "error.rs",
        "lib.rs",
        "arguments.rs",
        "manipulator.rs",
        "parser.rs",
        "printer.rs",
        "regex_generated.rs",
        "time_data_generated.rs",
        "types.rs",
    ],
    visibility = ["//visibility:public"],
)

generate_src_file(
    name = "time-data",
    src = "time_data_generated.rs",
    tool = "//packages/icu-messageformat-parser/tools:time_data_gen",
)

generate_src_file(
    name = "regex",
    src = "regex_generated.rs",
    tool = "//packages/icu-messageformat-parser/tools:regex_gen",
)

rust_library(
    name = "icu_messageformat_parser",
    srcs = [
        "arguments.rs",
        "date_time_pattern_generator.rs",
        "error.rs",
        "lib.rs",
        "manipulator.rs",
        "parser.rs",
        "printer.rs",
        "regex_generated.rs",
        "time_data_generated.rs",
        "types.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "formatjs_icu_messageformat_parser",
    crate_root = "lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/icu_skeleton_parser",
        "@crates//:icu",
        "@crates//:indexmap",
        "@crates//:once_cell",
        "@crates//:regex",
        "@crates//:serde",
    ],
)

formatjs_rust_test(
    name = "icu_messageformat_parser_test",
    srcs = [
        "arguments.test.rs",
        "date_time_pattern_generator.test.rs",
        "error.test.rs",
        "lib.test.rs",
        "manipulator.test.rs",
        "parser.test.rs",
        "printer.test.rs",
        "types.test.rs",
    ],
    crate_features = ["compiled_data"],
    crate_name = "icu_messageformat_parser_test",
    edition = "2024",
    deps = [
        ":icu_messageformat_parser",
        "@crates//:icu",
        "@crates//:indexmap",
        "@crates//:serde_json",
    ],
)

rust_binary(
    name = "parser_bench",
    srcs = ["parser.bench.rs"],
    crate_name = "parser_bench",
    crate_root = "parser.bench.rs",
    edition = "2024",
    deps = [
        ":icu_messageformat_parser",
        "@crates//:criterion",
    ],
)
