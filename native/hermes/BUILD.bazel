        "displaynames.ts",
        "get_canonical_locales.js",
        "listformat.ts",
        "locale.ts",
        "pluralrules.ts",
        "supported_values_of.ts",
    ],
    outs = ["extensions.js"],
    args = [
        "--input=$(rootpath :get_canonical_locales.js)",
        "--name=IntlGetCanonicalLocales",
        "--input=$(rootpath :supported_values_of.ts)",
        "--name=IntlSupportedValuesOf",
        "--input=$(rootpath :locale.ts)",
        "--name=IntlLocale",
        "--input=$(rootpath :pluralrules.ts)",
        "--name=IntlPluralRules",
        "--input=$(rootpath :listformat.ts)",
        "--name=IntlListFormat",
        "--input=$(rootpath :displaynames.ts)",
        "--name=IntlDisplayNames",
        "--out=$(rootpath :extensions.js)",
