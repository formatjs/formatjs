)

genrule(
    name = "wrapper_source",
    srcs = ["get_canonical_locales.js"],
    outs = ["get_canonical_locales.inc"],
    cmd = "printf 'R\"FORMATJS(' > $@; cat $< >> $@; printf ')FORMATJS\"' >> $@",
    visibility = ["//native/hermes/package:__pkg__"],
)

ts_run_binary(
    name = "extension_js",
    srcs = ["get_canonical_locales.js"],
    outs = ["30-IntlGetCanonicalLocales.js"],
    args = [
        "--input=$(rootpath :get_canonical_locales.js)",
        "--out=$(rootpath :30-IntlGetCanonicalLocales.js)",
    ],
    tool = "//native/hermes/scripts:extension",
    visibility = ["//visibility:public"],
)

ts_run_binary(
    name = "extension_bundle_js",
