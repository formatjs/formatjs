if(NOT FORMATJS_HERMES_SDK)
  message(FATAL_ERROR "Set FORMATJS_HERMES_SDK to the extracted FormatJS Hermes SDK")
endif()

if(ANDROID)
  if(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
    set(formatjs_intl_triple aarch64-linux-android)
  elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64")
    set(formatjs_intl_triple x86_64-linux-android)
  endif()
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
  set(formatjs_intl_triple x86_64-unknown-linux-gnu)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
  set(formatjs_intl_triple aarch64-apple-darwin)
endif()

if(NOT formatjs_intl_triple)
  message(FATAL_ERROR "FormatJS Hermes Intl has no archive for ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
endif()

set(formatjs_intl_archive "${FORMATJS_HERMES_SDK}/lib/${formatjs_intl_triple}/libformatjs_intl_hermes.a")
if(NOT EXISTS "${formatjs_intl_archive}")
  message(FATAL_ERROR "Missing FormatJS Hermes Intl archive: ${formatjs_intl_archive}")
endif()

file(GLOB formatjs_intl_sources "${FORMATJS_HERMES_SDK}/src/*.cpp")
target_sources(hermesapi_obj PRIVATE ${formatjs_intl_sources})
target_include_directories(hermesapi_obj PRIVATE "${FORMATJS_HERMES_SDK}/include")
target_link_libraries(hermesapi "${formatjs_intl_archive}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  target_link_libraries(hermesapi gcc_s util rt pthread m dl)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
  target_link_libraries(hermesapi resolv)
endif()
