include_guard(GLOBAL)

function(formatjs_intl target)
  get_filename_component(sdk "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  set(link_target "${target}")
  if(ARGC GREATER 1)
    set(link_target "${ARGV1}")
  endif()

  set(architecture "${CMAKE_SYSTEM_PROCESSOR}")
  if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
    if(NOT architecture_count EQUAL 1)
      message(FATAL_ERROR "FormatJS Intl: select one CMAKE_OSX_ARCHITECTURES value per build")
    endif()
    set(architecture "${CMAKE_OSX_ARCHITECTURES}")
  endif()

  if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
    if(CMAKE_OSX_SYSROOT MATCHES "[Ii][Pp]hone[Ss]imulator")
      if(architecture MATCHES "^(arm64|aarch64)$")
        set(triple aarch64-apple-ios-sim)
      elseif(architecture MATCHES "^(x86_64|AMD64)$")
        set(triple x86_64-apple-ios)
      endif()
    elseif(architecture MATCHES "^(arm64|aarch64)$")
      set(triple aarch64-apple-ios)
    endif()
  elseif(ANDROID)
    if(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a" OR ANDROID_ABI STREQUAL "arm64-v8a")
      set(triple aarch64-linux-android)
    elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "x86_64" OR ANDROID_ABI STREQUAL "x86_64")
      set(triple x86_64-linux-android)
    endif()
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND architecture MATCHES "^(x86_64|AMD64)$")
    set(triple x86_64-unknown-linux-gnu)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND architecture MATCHES "^(arm64|aarch64)$")
    set(triple aarch64-apple-darwin)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND architecture MATCHES "^(x86_64|AMD64)$")
    set(triple x86_64-apple-darwin)
  endif()

  if(NOT triple)
    message(FATAL_ERROR "FormatJS Intl: unsupported target ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}/${ANDROID_ABI}")
  endif()
  set(archive "${sdk}/lib/${triple}/libformatjs_intl_hermes.a")
  if(NOT EXISTS "${archive}")
    message(FATAL_ERROR "FormatJS Intl: missing ${archive}; extract the matching SDK archive")
  endif()

  file(GLOB sources CONFIGURE_DEPENDS "${sdk}/src/*.cpp")
  target_sources(${target} PRIVATE ${sources})
  target_include_directories(${target} PRIVATE "${sdk}/include")
  target_compile_features(${target} PRIVATE cxx_std_17)
  target_compile_options(${target} PRIVATE -fexceptions)
  target_link_libraries(${link_target} "${archive}")
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_link_libraries(${link_target} gcc_s util rt pthread m dl)
  elseif(APPLE)
    target_link_libraries(${link_target} resolv)
  elseif(ANDROID)
    target_link_libraries(${link_target} dl m)
  endif()
endfunction()
