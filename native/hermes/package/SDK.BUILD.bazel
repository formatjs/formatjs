load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

cc_import(
    name = "rust_intl",
    static_library = select({
        ":darwin_arm64": "lib/aarch64-apple-darwin/libformatjs_intl_hermes.a",
        ":linux_x86_64": "lib/x86_64-unknown-linux-gnu/libformatjs_intl_hermes.a",
    }),
)

cc_library(
    name = "bridge",
    hdrs = ["include/formatjs/hermes/bridge.h"],
    strip_include_prefix = "include",
    deps = ["@hermes//:headers"],
)

cc_library(
    name = "canonical_locales",
    srcs = [
        "src/canonical_locales.cpp",
        "src/get_canonical_locales.inc",
    ],
    hdrs = [
        "include/formatjs/hermes/canonical_locales.h",
        "include/formatjs/intl/canonicalize.h",
    ],
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    linkopts = select({
        ":darwin_arm64": [
            "-lSystem",
            "-lresolv",
        ],
        ":linux_x86_64": [
            "-lgcc_s",
            "-lutil",
            "-lrt",
            "-lpthread",
            "-lm",
            "-ldl",
        ],
    }),
    strip_include_prefix = "include",
    deps = [
        ":bridge",
        ":rust_intl",
        "@hermes//:headers",
    ],
)

cc_library(
    name = "supported_values",
    srcs = [
        "src/supported_values.cpp",
        "src/supported_values_of.inc",
    ],
    hdrs = [
        "include/formatjs/hermes/supported_values.h",
        "include/formatjs/intl/supported_values.h",
    ],
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    linkopts = select({
        ":darwin_arm64": [
            "-lSystem",
            "-lresolv",
        ],
        ":linux_x86_64": [
            "-lgcc_s",
            "-lutil",
            "-lrt",
            "-lpthread",
            "-lm",
            "-ldl",
        ],
    }),
    strip_include_prefix = "include",
    deps = [
        ":bridge",
        ":rust_intl",
        "@hermes//:headers",
    ],
)

cc_library(
    name = "locale",
    srcs = [
        "src/locale.cpp",
        "src/locale.inc",
    ],
    hdrs = [
        "include/formatjs/hermes/intl_locale.h",
        "include/formatjs/intl/canonicalize.h",
        "include/formatjs/intl/locale.h",
    ],
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    linkopts = select({
        ":darwin_arm64": [
            "-lSystem",
            "-lresolv",
        ],
        ":linux_x86_64": [
            "-lgcc_s",
            "-lutil",
            "-lrt",
            "-lpthread",
            "-lm",
            "-ldl",
        ],
    }),
    strip_include_prefix = "include",
    deps = [
        ":bridge",
        ":rust_intl",
        "@hermes//:headers",
    ],
)

alias(
    name = "rust_canonicalizer",
    actual = ":rust_intl",
)

cc_library(
    name = "pluralrules",
    srcs = [
        "src/pluralrules.cpp",
        "src/pluralrules.inc",
    ],
    hdrs = [
        "include/formatjs/hermes/intl_pluralrules.h",
        "include/formatjs/intl/pluralrules.h",
    ],
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    linkopts = select({
        ":darwin_arm64": [
            "-lSystem",
            "-lresolv",
        ],
        ":linux_x86_64": [
            "-lgcc_s",
            "-lutil",
            "-lrt",
            "-lpthread",
            "-lm",
            "-ldl",
        ],
    }),
    strip_include_prefix = "include",
    deps = [
        ":bridge",
        ":rust_intl",
        "@hermes//:headers",
    ],
)

filegroup(
    name = "pluralrules_data",
    srcs = glob(["locale-data/pluralrules/*.json"]),
)

exports_files(glob(["locale-data/pluralrules/*.json"]))

exports_files([
    "js/30-IntlGetCanonicalLocales.js",
    "js/extensions.js",
    "js/31-IntlSupportedValuesOf.js",
    "js/32-IntlLocale.js",
    "js/33-IntlPluralRules.js",
    "js/pluralrules-smoke.js",
    "examples/pluralrules-smoke.ts",
])
