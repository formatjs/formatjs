load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_java//java:defs.bzl", "java_import", "java_test")

exports_files(["locale-format-fixtures.tsv"])

copy_to_bin(
    name = "locale_format_fixtures",
    srcs = ["locale-format-fixtures.tsv"],
    visibility = ["//native/hermes/tests:__pkg__"],
)

java_import(
    name = "icu4j",
    jars = ["@icu4j_jar//file"],
)

java_test(
    name = "icu_conformance_test",
    size = "small",
    srcs = ["ICUConformanceTest.java"],
    data = ["//packages/intl-localematcher:tests/locale-match-fixtures.json"],
    env = {
        "LOCALE_MATCH_FIXTURES": "$(rootpath //packages/intl-localematcher:tests/locale-match-fixtures.json)",
    },
    main_class = "ICUConformanceTest",
    test_class = "ICUConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "intl_locale_formatting_conformance_test",
    size = "small",
    srcs = ["IntlLocaleFormattingConformanceTest.java"],
    data = ["locale-format-fixtures.tsv"],
    env = {"LOCALE_FORMAT_FIXTURES": "$(rootpath locale-format-fixtures.tsv)"},
    main_class = "IntlLocaleFormattingConformanceTest",
    test_class = "IntlLocaleFormattingConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "messageformat_escaping_conformance_test",
    size = "small",
    srcs = ["MessageFormatEscapingConformanceTest.java"],
    main_class = "MessageFormatEscapingConformanceTest",
    test_class = "MessageFormatEscapingConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "intl_collator_conformance_test",
    size = "small",
    srcs = ["IntlCollatorConformanceTest.java"],
    data = ["//packages/intl-collator:tests/collator-conformance.tsv"],
    env = {
        "COLLATOR_CONFORMANCE_FIXTURES": "$(rootpath //packages/intl-collator:tests/collator-conformance.tsv)",
    },
    main_class = "IntlCollatorConformanceTest",
    test_class = "IntlCollatorConformanceTest",
    deps = [":icu4j"],
)
