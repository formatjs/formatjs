load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_java//java:defs.bzl", "java_binary", "java_import", "java_test")

exports_files(["locale-format-fixtures.tsv"])

copy_to_bin(
    name = "locale_format_fixtures",
    srcs = ["locale-format-fixtures.tsv"],
    visibility = ["//native/hermes/tests:__pkg__"],
)

java_binary(
    name = "locale_matcher_oracle",
    testonly = True,
    srcs = [
        "ICUConformanceTest.java",
        "LocaleMatcherConformanceTest.java",
    ],
    main_class = "LocaleMatcherConformanceTest",
    deps = [":icu4j"],
)

genrule(
    name = "locale_matcher_grid",
    testonly = True,
    outs = ["locale-matcher-grid.tsv"],
    cmd = "$(execpath :locale_matcher_oracle) --grid $@",
    tools = [":locale_matcher_oracle"],
    visibility = ["//visibility:public"],
)

java_import(
    name = "icu4j",
    jars = ["@icu4j_jar//file"],
    visibility = ["//benchmarks/locale-matching:__pkg__"],
)

java_test(
    name = "icu_conformance_test",
    size = "small",
    srcs = [
        "ICUConformanceTest.java",
        "LocaleMatcherConformanceTest.java",
    ],
    data = ["//packages/intl-localematcher:tests/icu-match-fixtures.json"],
    env = {
        "LOCALE_MATCH_FIXTURES": "$(rootpath //packages/intl-localematcher:tests/icu-match-fixtures.json)",
    },
    main_class = "ICUConformanceTest",
    test_class = "ICUConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "intl_locale_formatting_conformance_test",
    size = "small",
    srcs = ["IntlLocaleFormattingConformanceTest.java"],
    data = ["locale-format-fixtures.tsv"],
    env = {"LOCALE_FORMAT_FIXTURES": "$(rootpath locale-format-fixtures.tsv)"},
    main_class = "IntlLocaleFormattingConformanceTest",
    test_class = "IntlLocaleFormattingConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "messageformat_escaping_conformance_test",
    size = "small",
    srcs = ["MessageFormatEscapingConformanceTest.java"],
    main_class = "MessageFormatEscapingConformanceTest",
    test_class = "MessageFormatEscapingConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "intl_collator_conformance_test",
    size = "small",
    srcs = ["IntlCollatorConformanceTest.java"],
    data = ["//packages/intl-collator:tests/collator-conformance.tsv"],
    env = {
        "COLLATOR_CONFORMANCE_FIXTURES": "$(rootpath //packages/intl-collator:tests/collator-conformance.tsv)",
    },
    main_class = "IntlCollatorConformanceTest",
    test_class = "IntlCollatorConformanceTest",
    deps = [":icu4j"],
)

java_test(
    name = "locale_matcher_conformance_test",
    size = "small",
    srcs = [
        "ICUConformanceTest.java",
        "LocaleMatcherConformanceTest.java",
    ],
    data = ["//packages/intl-localematcher:tests/icu-match-fixtures.json"],
    env = {"LOCALE_MATCH_FIXTURES": "$(rootpath //packages/intl-localematcher:tests/icu-match-fixtures.json)"},
    main_class = "LocaleMatcherConformanceTest",
    test_class = "LocaleMatcherConformanceTest",
    deps = [":icu4j"],
)

java_binary(
    name = "intl_listformat_oracle",
    testonly = True,
    srcs = ["IntlListFormatOracle.java"],
    main_class = "IntlListFormatOracle",
    deps = [":icu4j"],
)

genrule(
    name = "list_format_fixtures",
    testonly = True,
    srcs = ["list-format-icu-differences.tsv"],
    outs = ["list-format-fixtures.tsv"],
    cmd = "$(execpath :intl_listformat_oracle) $@ $(location list-format-icu-differences.tsv)",
    tools = [":intl_listformat_oracle"],
    visibility = ["//visibility:public"],
)

java_binary(
    name = "intl_pluralrules_oracle",
    testonly = True,
    srcs = ["IntlPluralRulesOracle.java"],
    main_class = "IntlPluralRulesOracle",
    deps = [":icu4j"],
)

genrule(
    name = "plural_rules_fixtures",
    testonly = True,
    outs = ["plural-rules-fixtures.tsv"],
    cmd = "$(execpath :intl_pluralrules_oracle) $@",
    tools = [":intl_pluralrules_oracle"],
    visibility = ["//visibility:public"],
)
