# gazelle:ignore
load("@rules_cc//cc:cc_test.bzl", "cc_test")

exports_files(["icu.BUILD.bazel"])

cc_test(
    name = "intl_relativetimeformat_conformance_test",
    size = "small",
    srcs = ["relativetime.cc"],
    data = ["//conformance-tests/icu4x:relative-icu4x-differences.tsv"],
    env = {"RELATIVE_TIME_DIFFERENCES": "$(rootpath //conformance-tests/icu4x:relative-icu4x-differences.tsv)"},
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = ["@icu4c_linux_x86_64//:icu"],
)

