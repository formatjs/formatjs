# gazelle:ignore
load("//tools:rust_test.bzl", "formatjs_rust_test")

formatjs_rust_test(
    name = "intl_collator_conformance_test",
    srcs = ["collator.test.rs"],
    crate_name = "icu4x_collator_conformance_test",
    data = ["//packages/intl-collator:tests/collator-conformance.tsv"],
    edition = "2024",
    env = {"COLLATOR_CONFORMANCE_FIXTURES": "$(rootpath //packages/intl-collator:tests/collator-conformance.tsv)"},
    deps = [
        "@crates//:icu_collator-2.3.1",
        "@crates//:icu_locale",
    ],
)

formatjs_rust_test(
    name = "intl_listformat_conformance_test",
    srcs = ["listformat.test.rs"],
    crate_name = "icu4x_listformat_conformance_test",
    data = [
        "list-format-icu-differences.tsv",
        "//conformance-tests/icu4j:list_format_fixtures",
    ],
    edition = "2024",
    env = {
        "LIST_FORMAT_FIXTURES": "$(rootpath //conformance-tests/icu4j:list_format_fixtures)",
        "ICU4X_LIST_DIFFERENCES": "$(rootpath list-format-icu-differences.tsv)",
    },
    deps = [
        "@crates//:icu_list-2.3.0",
        "@crates//:icu_locale",
    ],
)

formatjs_rust_test(
    name = "intl_pluralrules_conformance_test",
    srcs = ["pluralrules.test.rs"],
    crate_name = "icu4x_pluralrules_conformance_test",
    data = ["//conformance-tests/icu4j:plural_rules_fixtures"],
    edition = "2024",
    env = {"PLURAL_RULES_FIXTURES": "$(rootpath //conformance-tests/icu4j:plural_rules_fixtures)"},
    deps = [
        "@crates//:fixed_decimal",
        "@crates//:icu_locale",
        "@crates//:icu_plurals",
    ],
)
